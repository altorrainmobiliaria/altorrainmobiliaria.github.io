#!/bin/sh
# ===========================================================
# 🧠 pre-commit — guardián determinista del cerebro
# ===========================================================
# Corre brain:check cuando el commit toca el CEREBRO o su MAQUINARIA y
# BLOQUEA el commit si el cerebro tiene problemas. Convierte el Reflejo de
# Auto-auditoría (CLAUDE.md §G.4) de doctrina-que-debo-recordar a
# garantía determinista (M-10: lo verificable va al linter que falla).
#
# Activar (una vez):  git config core.hooksPath githooks
# Saltar (intencional): git commit --no-verify
# ===========================================================
staged=$(git diff --cached --name-only)

# ── Puerta de node para TODO el hook (auditoría Nivel-2 #6) ──────────────────────────────────────
# Antes vivía abajo, tapando solo a brain:check, y los gates de arriba se saltaban
# EN SILENCIO cuando faltaba node. Falla CERRADO y de una vez para todos: un gate
# que no pudo mirar no puede salir en verde.
if ! command -v node >/dev/null 2>&1; then
  echo ""
  echo "❌ COMMIT BLOQUEADO: 'node' no está en PATH, así que los gates NO pueden correr."
  echo "   Arregla el PATH, o salta a conciencia: git commit --no-verify"
  exit 1
fi

# ── Credenciales en un repo PÚBLICO (§262 · auditoría #18, N18-06) ─────────────────────────────────
# SIN predicado de rutas, y ESE es el arreglo: este barrido vivía dentro del `if`
# de `js/` de abajo, así que 55 de los últimos 100 commits NO lo corrían — un SA
# JSON en `functions/`, `scripts/`, `docs/` o la raíz entraba sin escáner a un repo
# que GitHub indexa. Un secreto no pide permiso por carpeta; el gate tampoco.
node scripts/verify-secretos.mjs || exit 1

# ── Contratos del panel LEGACY (§136) ──────────────────────────────────────
# Va ANTES del corte del cerebro: este gate mira `js/`, no `docs/`, y si se
# pusiera después no correría nunca en un commit de solo código — que es
# justamente cuando hace falta. Un cambio de contrato con un callsite sin
# migrar dejó al dueño fuera de su propio panel.
if echo "$staged" | grep -qE '^js/'; then
  node scripts/verify-contratos-legacy.mjs || {
    echo ""
    echo "❌ COMMIT BLOQUEADO: hay un callsite con el contrato viejo (arriba, con su línea)."
    exit 1
  }
fi

# ── 🚨 La ALERTA DEL VIGÍA se cierra AQUÍ, y solo con evidencia (PLAN-CIERRE §5, capa 2) ────────
# El vigía de la bóveda (tarea diaria de Windows, 07:00) levanta `docs/.vigia-alerta` cuando algo
# del cerebro sale ROJO sin nadie delante; el SessionStart lo convierte en una orden ⛔ al arrancar.
# Ésta es la otra punta, y la condición NO es «hubo un commit» sino «el vigía volvió a dar VERDE»:
# por eso se vuelve a MEDIR aquí en vez de creerse que el commit arregló algo (§G.4: un flag que se
# cierra por confianza es un gate que miente).
#
# · Va ANTES del corte de `docs/` a propósito: una alerta se arregla casi siempre tocando `scripts/`
#   o la configuración, no `docs/`, y si el cierre viviera abajo la alerta no se cerraría nunca.
# · Solo corre cuando HAY alerta abierta (medido: ~4 s las cinco piezas locales; cero coste el 99 %
#   de los días, que es cuando el flag no existe).
# · `--recheck` NO usa la red: mide con las refs remotas que ya haya y lo dice en el informe.
# · INFORMA y jamás bloquea: un rojo ajeno al commit que se está haciendo no puede detener el
#   trabajo, o el primer día se salta con `--no-verify` y con él se salta todo lo demás.
if [ -f docs/.vigia-alerta ]; then
  if [ ! -f ../brain-private/scripts/vigia.mjs ]; then
    echo "⚠️  hay una alerta del vigía abierta y la bóveda NO está clonada al lado: la alerta se queda (no se puede re-medir)."
  else
    echo "🚨 alerta del vigía abierta — re-midiendo (node ../brain-private/scripts/vigia.mjs --recheck)…"
    if vigia_out=$(node ../brain-private/scripts/vigia.mjs --recheck 2>&1); then
      rm -f docs/.vigia-alerta
      echo "✅ el vigía volvió a dar VERDE — docs/.vigia-alerta CERRADO por este commit."
    else
      echo "$vigia_out" | grep -E '^❌' || true
      echo "⚠️  el vigía SIGUE en rojo: la alerta se queda abierta (informe: ../brain-private/cerebro-maestro/VIGIA-ULTIMO.md)."
    fi
  fi
fi

# ── El predicado que decide si los gates llegan a MIRAR (v1.34.0 · R-01) ────────
# Hasta hoy esta línea decía `'^(CLAUDE\.md|docs/)'`, y ESA línea desarmaba de golpe a
# todos los chequeos que pueden bloquear: viven DEBAJO de ella. Medido el 2026-09-04 con
# una réplica del predicado sobre `git log --since=30.days --name-only` de los cuatro
# repos (721 commits): con el predicado viejo llegaban a correr brain:check **389 (54 %)**
# —INMO 330/576 · CARS 21/71 · BERS 23/42 · INSE 15/32— y de los **332** que salían por
# aquí sin un solo gate, **80 tocaban `scripts/`, `skills/`, `.claude/` o `githooks/`**:
# la MAQUINARIA del propio cerebro. Se editaba `scripts/brain-check.mjs` sin que ningún
# gate mirara. Con las seis rutas: **469 de 721 (65 %)** y **0** commits de maquinaria
# sin gate (INMO 368/576 · CARS 36/71 · BERS 38/42 · INSE 27/32).
# Es la segunda cara de [[INMO:L-70]] —«lee el predicado ANTES que el cuerpo, y mídelo
# contra la historia real»—, ya aplicada al escáner de secretos (`secretos.yml:12` dice
# «Por eso aquí NO hay `paths:`») y NO aplicada al linter del propio cerebro.
# ⚠️ Regla 4 de esa lección: un motivo para NO correr un gate CADUCA. Lo que queda fuera
# —código de producto, imágenes, `functions/`— se excluye porque este linter mide el
# CEREBRO y no el producto; el día que eso deje de ser cierto, se re-mide y se reescribe
# aquí, con fecha. Latencia medida: 0,278 s por corrida.
echo "$staged" | grep -qE '^(CLAUDE\.md|docs/|scripts/|skills/|githooks/|\.claude/)' || exit 0

echo "🧠 brain:check (pre-commit)…"
# `--pre-commit` NO cambia ni un chequeo (v1.34.0 · R-04): le dice al linter que su veredicto va a
# ABORTAR un commit, y por eso el detector de «árbol en movimiento» degrada aquí a ROJO en vez de
# limitarse a avisar. Un veredicto que no se puede firmar no puede dejar pasar un commit.
if ! node scripts/brain-check.mjs --pre-commit; then
  echo ""
  echo "❌ COMMIT BLOQUEADO: el cerebro tiene problemas (ver arriba)."
  echo "   Corrígelos, o usa 'git commit --no-verify' si es intencional."
  exit 1
fi

# 🔒 El candado del boot y el canario 🐤 SUBIERON AL KERNEL en v1.8.0 (ADR §81): hoy son los
# chequeos #2 y #24 de brain-check.mjs (arriba), bloqueantes en los 4 repos. El antiguo
# scripts/boot-gate.mjs instance-side se retiró en el mismo cambio (one-in-one-out).

# ── 🚩 El TOKEN de consolidación se CIERRA aquí (§291) ──────────────────────────
# El hook PreCompact deja `docs/.consolidacion-pendiente` y el SessionStart siguiente
# lo convierte en una orden ⛔ al arrancar. Esta es la otra punta: si el commit lleva
# `docs/10-*` o `docs/99-*`, la consolidación OCURRIÓ y el token muere. Va al final
# a propósito — después de brain:check— porque un gate en rojo aborta el commit y el
# pendiente tiene que sobrevivirlo.
# 🎯 Lo que se mide con esto NO es «el hook disparó» (0/15 entregas en 44 días y nadie
# se enteró) sino un pendiente que SE CIERRA; el chequeo #30 vigila los que envejecen.
if echo "$staged" | grep -qE '^docs/(10|99)-' && [ -f docs/.consolidacion-pendiente ]; then
  rm -f docs/.consolidacion-pendiente
  echo "🚩 consolidación PENDIENTE cerrada — docs/.consolidacion-pendiente borrado por este commit."
fi

exit 0
