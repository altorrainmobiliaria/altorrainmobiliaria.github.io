rules_version = '2';

// Reglas Firestore del PORTAL (modelo de datos v1, Ola 0.7). Frontera PÚBLICO vs INTERNO/PII (OD3),
// endurecidas tras revisión adversarial ×3 lentes (fail-closed + free-tier).
//
// POSTURA DE ESCRITURA (OD1, marcada para ratificación Fable): TODA escritura pasa por Cloud Functions
// (Admin SDK, que BYPASSA estas reglas) → los invariantes viven server-side: contador INM atómico (OD8),
// `_version` (L-04), transacción anti-overbooking, `leadScore`, validación de garantía (OD9). Por eso el
// cliente NUNCA escribe directo (`allow write: if false`). El client SDK del admin es solo para LECTURA
// acotada (realtime de admin). Seeding = scripts Admin SDK (bypassan reglas).
//
// ⚠️ `firebase deploy --only firestore:rules,firestore:indexes` = lo hace el DUEÑO, COORDINADO: el proyecto
//    `altorra-inmobiliaria-345c6` lo comparte el legacy → el `default deny-all` reemplaza su ruleset (ver README).
// TODO(0.7): tests contra el emulador (T6) antes de desplegar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff = autenticado CON custom claim `admin==true` (lo setea un proceso de confianza vía Admin SDK).
    function isStaff() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ---------- PÚBLICO (lectura acotada, FAIL-CLOSED) ----------
    // Catálogo: GET solo de estados realmente públicos (whitelist; 'cerrado' = ficha permanente por SEO).
    // LIST público denegado (la SERP se sirve de JSON cacheado, no de queries de cliente — free-tier).
    match /propiedades/{id} {
      allow get: if resource.data.estado in ['disponible', 'reservado', 'cerrado'];
      allow list: if isStaff();
      allow write: if false;
    }
    // Disponibilidad: GET puntual público; LIST denegado (el calendario se sirve por edge/JSON cacheado — OD1).
    match /disponibilidad/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
    // Config: GET público SOLO de docs no sensibles (general/promo/system-meta); gestion/counters = staff.
    match /config/{doc} {
      allow get: if !(doc in ['gestion', 'counters']) || isStaff();
      allow list: if isStaff();
      allow write: if false;
    }
    // Índice de catálogo denormalizado (OD-Catálogo §54): GET público SOLO de los shards CONOCIDOS
    // (allow-list explícita, defensa en profundidad §54.4). Contenido = solo resúmenes de propiedades
    // PUBLICADAS (la Function filtra estado) → NO filtra borradores por diseño. LIST y WRITE denegados.
    match /indices/{doc} {
      allow get: if doc in ['catalogo-venta', 'catalogo-arriendo', 'catalogo-dias'];
      allow list, write: if false;
    }

    // ---------- INTERNO / PII (lectura solo staff; escritura solo Functions) ----------
    match /captaciones/{id} { allow read: if isStaff(); allow write: if false; } // PII propietario/dirección/matrícula/comisión

    // ⚠️ ALTA PÚBLICA ACOTADA — `solicitudes` y `alertas` son las DOS colecciones donde un visitante
    // anónimo puede CREAR (nunca leer, nunca editar, nunca borrar). No es una relajación: es lo que el
    // portal ya hace hoy y estas reglas no reflejaban.
    //
    // EL BUG QUE ESTO ARREGLA (ADR §96): `pages/api/solicitud.ts` escribe `solicitudes` por REST con la
    // apiKey pública, y funciona porque el ruleset VIVO del proyecto sigue siendo el del legacy. Con
    // `allow write: if false` aquí, el día que este archivo se despliegue (cutover, TODO-17) los
    // formularios de `/publicar` y del Rango dejarían de capturar leads — sin un solo error en la web,
    // que es la peor forma de romperse. La postura «toda escritura pasa por Functions» se mantiene para
    // todo lo demás: aquí lo que entra es un ALTA sin estado ni dinero, y los invariantes caros
    // (scoring, contadores, envío) los siguen poniendo las Functions después.
    match /solicitudes/{id} {
      allow read: if isStaff();
      allow create: if request.resource.data.estado == 'pendiente'
                    && request.resource.data.consentimiento.autorizado == true
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() >= 2
                    && request.resource.data.nombre.size() <= 80
                    && request.resource.data.telefono is string
                    && request.resource.data.telefono.size() <= 25
                    && request.resource.data.emailSent == false;
      allow update, delete: if false;
    }

    // Alertas guardadas (OLA 1 ítem 8). El `create` valida FORMA y TOPES, que es lo que las reglas
    // pueden comprobar de verdad; el correo se valida en el endpoint. `hasOnly` cierra la puerta a que
    // alguien meta campos que la Function no espera. Nadie puede LEERLAS: dentro va el `token` de la
    // baja, y un token legible no protege nada.
    match /alertas/{id} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(
                         ['email', 'criterios', 'estado', 'token', 'consentimiento',
                          'ultimoEnvio', 'enviados', 'createdAt', 'updatedAt', '_version'])
                    && request.resource.data.estado == 'activa'
                    && request.resource.data.enviados == 0
                    && request.resource.data._version == 1
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 120
                    && request.resource.data.token is string
                    && request.resource.data.token.size() >= 16
                    && request.resource.data.consentimiento.autorizado == true
                    && request.resource.data.criterios.operacion in ['venta', 'arriendo', 'alojamiento']
                    && request.resource.data.criterios.tipos.size() <= 8
                    && request.resource.data.criterios.zonas.size() <= 8;
      // El paso a `baja` lo hace SOLO la Function del digest (Admin SDK, que bypassa estas reglas).
      allow update, delete: if false;
    }

    // Peticiones de BAJA (append-only). Es el permiso más pequeño que permite revocar sin dejar que el
    // público edite `alertas`: aquí solo se pide la baja, y la Function la aplica tras comprobar el
    // token. `aplicada == false` obliga a que nadie la marque como hecha al crearla.
    match /bajasAlertas/{id} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['alertaId', 'token', 'createdAt', 'aplicada'])
                    && request.resource.data.alertaId is string
                    && request.resource.data.alertaId.size() <= 64
                    && request.resource.data.token is string
                    && request.resource.data.token.size() <= 64
                    && request.resource.data.aplicada == false;
      allow update, delete: if false;
    }

    match /actividades/{id} { allow read: if isStaff(); allow write: if false; }
    match /expedientes/{id} { allow read: if isStaff(); allow write: if false; }
    match /contratos/{id}   { allow read: if isStaff(); allow write: if false; }
    match /pagos/{id}       { allow read: if isStaff(); allow write: if false; }
    match /novedades/{id}   { allow read: if isStaff(); allow write: if false; }

    // ---------- DEFAULT: todo lo no declarado, DENEGADO (incluye loginAttempts C-25 y legacy) ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
