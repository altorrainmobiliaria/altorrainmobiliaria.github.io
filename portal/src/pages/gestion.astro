---
import { srcsetDe, SIZES } from '../lib/img';
/*
 * GESTIÓN — panel de administración (Ola 1). Réplica de ALTORRA Gestion.dc.html (mockup aprobado).
 * Dashboard con 3 VISTAS por rol (Admin / Aliado / Propietario) que intercambian TODA la data
 * vía segmentado. Datos DEMO estáticos — la capa real (auth + Firestore) es posterior.
 * noindex SIEMPRE (interno). Sin Header/Footer públicos: layout propio con sidebar.
 * Interactividad SIN innerHTML: las 3 vistas se renderizan server-side y se alternan con `hidden`
 * (progressive enhancement, sin FOUC). Nota: "Demanda por zona" = medidores CSS del mockup aprobado.
 */
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { ZONAS } from '../lib/content/zonas';
import { TIPOS_INMUEBLE } from '../lib/domain/shared';
import { NOMBRE_DOCUMENTO, TIPOS_DOCUMENTO } from '../lib/domain/documentos';

const nav = [
  { id: 'resumen', label: 'Resumen', active: true, icon: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>' },
  { id: 'inmuebles', label: 'Inmuebles', icon: '<path d="M3 10.5 12 4l9 6.5"/><path d="M5 9.5V20h14V9.5"/><path d="M9.5 20v-6h5v6"/>' },
  // «Contratos» sale del mockup aprobado el 2026-08-22 (`ALTORRA Gestion-Alta.dc.html`). Se AÑADE:
  // los que ya estaban vienen del mockup anterior, también aprobado, y quitarlos no lo pidió nadie.
  { id: 'contratos', label: 'Contratos', icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/>' },
  // «Ventas» va junto a Contratos: son las dos formas en que una operación termina, y el
  // operador que revisa una revisa la otra.
  { id: 'ventas', label: 'Ventas', icon: '<path d="M3 10.5 12 4l9 6.5"/><path d="M5 9.5V20h14V9.5"/><path d="m9 14 2 2 4-4"/>' },
  // «Liquidación» va pegada a Contratos porque se responde con el mismo dato: abierto un contrato,
  // la pregunta siguiente es siempre «¿y cuánto le giro este mes?» (§167).
  { id: 'liquidacion', label: 'Liquidación', icon: '<path d="M12 3v18"/><path d="M16.5 7.5c0-1.7-2-2.5-4.5-2.5S7.5 5.8 7.5 7.5 9.5 10 12 10s4.5 1 4.5 2.7-2 2.8-4.5 2.8-4.5-1-4.5-2.5"/>' },
  // «Expedientes» es el agregado RAÍZ: contratos, pagos y novedades cuelgan de él. Va justo
  // después de Contratos porque es donde el operador acaba cuando algo no cuadra.
  { id: 'expedientes', label: 'Expedientes', icon: '<path d="M3 7.5A2 2 0 0 1 5 5.5h4l2 2.5h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M8 14h8"/>' },
  // «Perfiles» va junto a Leads: los dos son personas esperando una respuesta nuestra, y la
  // promesa de las 24 horas se incumple en el mismo sitio donde se incumple la de un lead.
  { id: 'perfiles', label: 'Perfiles', icon: '<circle cx="12" cy="8" r="3.4"/><path d="M5 20c0-3.4 3.1-5.6 7-5.6s7 2.2 7 5.6"/>' },
  { id: 'leads', label: 'Leads', icon: '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.2 2.9-5.3 6.5-5.3s6.5 2.1 6.5 5.3"/><path d="M17 5.4A3.2 3.2 0 0 1 17 11.6M22 20c0-2.4-1.5-4.2-3.7-4.9"/>' },
  /*
   * `pronto` = la sección está en el menú del mockup pero todavía no existe. Hasta hoy estas dos
   * entradas —y «Leads»— eran enlaces que al pulsarlos **no hacían absolutamente nada**: el enrutador
   * hacía `if (!destino) return`. Desde fuera, un menú que no responde no se distingue de un panel
   * roto, y es exactamente el «botón fantasma» de §126. Ahora se marcan y, al pulsarlas, DICEN qué
   * pasa. Cuando la sección exista, se quita el `pronto` y se le da su destino.
   */
  { id: 'visitas', label: 'Visitas', pronto: true, icon: '<rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>' },
  { id: 'documentos', label: 'Documentos', icon: '<path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M18 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8l5 5v11a2 2 0 0 1-2 2z"/><path d="M8 13h8M8 17h5"/>' },
];

/** Los tipos de documento, para el desplegable. La lista vive en el DOMINIO, no aquí. */
const TIPOS_DOC = TIPOS_DOCUMENTO.map((id) => ({ id, nombre: NOMBRE_DOCUMENTO[id] }));

/** Lo que se le dice a alguien que pulsa una sección que aún no existe. Nunca el silencio. */
const NOTA_PRONTO: Record<string, string> = {
  visitas: 'Las visitas se agendan hoy desde la ficha de cada inmueble y desde WhatsApp. La agenda del panel llega con el cutover.',
};

// Iconos por KPI (línea navy en tile mist) — mismo lenguaje visual del mockup, uno por métrica.
const KPI_ICONS = [
  '<path d="M3 10.5 12 4l9 6.5"/><path d="M5 9.5V20h14V9.5"/>',
  '<circle cx="9" cy="8" r="3.2"/><path d="M2.5 20c0-3.2 2.9-5.3 6.5-5.3s6.5 2.1 6.5 5.3"/><path d="M17 5.4A3.2 3.2 0 0 1 17 11.6"/>',
  '<rect x="3" y="4.5" width="18" height="16" rx="2"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/>',
  '<path d="M3 3v18h18"/><path d="M7 15l3.5-4 3 2.5L21 8"/>',
];
const TREND = '<path d="M6 15l6-6 6 6"/>';

// --- Datos DEMO por rol (del mockup). `tone` = gold|navy (→ color de paleta AA en CSS). ---
const DATA = {
  admin: {
    user: 'Alejandro C.', userRole: 'Administrador', avatar: 'A',
    greeting: 'Buenos días, Alejandro',
    subtitle: 'Panel general · toda la operación ALTORRA',
    tableTitle: 'Pipeline de leads',
    kpis: [
      { label: 'Inmuebles activos', value: '48', trend: '+6' },
      { label: 'Leads nuevos', value: '127', trend: '+18%' },
      { label: 'Visitas esta semana', value: '32', trend: '+4' },
      { label: 'Ventas del mes', value: '$4.850M', trend: '+12%' },
    ],
    rows: [
      { initials: 'VR', client: 'Valentina Ríos', inm: 'Apto Castillogrande', zona: 'Castillogrande', etapa: 'Negociación', tone: 'gold', valor: '$1.450M' },
      { initials: 'TS', client: 'Thomas Shelby', inm: 'Casa Manga', zona: 'Manga', etapa: 'Nuevo', tone: 'navy', valor: '$980M' },
      { initials: 'LG', client: 'Laura Gómez', inm: 'Penthouse Bocagrande', zona: 'Bocagrande', etapa: 'En visita', tone: 'gold', valor: '$2.100M' },
      { initials: 'DF', client: 'Diego Fernández', inm: 'Casa Crespo', zona: 'Crespo', etapa: 'Cierre', tone: 'gold', valor: '$760M' },
      { initials: 'SM', client: 'Sofía Márquez', inm: 'Lote La Boquilla', zona: 'La Boquilla', etapa: 'Nuevo', tone: 'navy', valor: '$520M' },
      { initials: 'AM', client: 'Andrés Mejía', inm: 'Local Centro', zona: 'Centro', etapa: 'En visita', tone: 'gold', valor: '$1.100M' },
    ],
    activities: [
      { tone: 'gold', text: 'Nuevo lead · Sofía Márquez interesada en Lote La Boquilla', time: 'hace 12 min' },
      { tone: 'gold', text: 'Visita agendada · Penthouse Bocagrande', time: 'hace 40 min' },
      { tone: 'gold', text: 'Cierre confirmado · Casa Crespo por $760M', time: 'hace 2 h' },
      { tone: 'navy', text: 'Documento cargado · Escritura Apto Castillogrande', time: 'hace 3 h' },
    ],
  },
  aliado: {
    user: 'Julián Peña', userRole: 'Aliado ALTORRA', avatar: 'J',
    greeting: 'Hola, Julián',
    subtitle: 'Tu cartera como aliado · comisiones y leads',
    tableTitle: 'Mis leads asignados',
    kpis: [
      { label: 'Mis inmuebles', value: '12', trend: '+2' },
      { label: 'Mis leads', value: '34', trend: '+9' },
      { label: 'Visitas agendadas', value: '8', trend: '+3' },
      { label: 'Comisión acumulada', value: '$186M', trend: '+15%' },
    ],
    rows: [
      { initials: 'LG', client: 'Laura Gómez', inm: 'Penthouse Bocagrande', zona: 'Bocagrande', etapa: 'En visita', tone: 'gold', valor: '$2.100M' },
      { initials: 'AM', client: 'Andrés Mejía', inm: 'Local Centro', zona: 'Centro', etapa: 'Negociación', tone: 'gold', valor: '$1.100M' },
      { initials: 'CR', client: 'Carla Ruiz', inm: 'Apto Bocagrande', zona: 'Bocagrande', etapa: 'Nuevo', tone: 'navy', valor: '$890M' },
      { initials: 'PN', client: 'Pedro Nel', inm: 'Oficina Manga', zona: 'Manga', etapa: 'Cierre', tone: 'gold', valor: '$640M' },
    ],
    activities: [
      { tone: 'gold', text: 'Nuevo lead asignado · Carla Ruiz · Apto Bocagrande', time: 'hace 25 min' },
      { tone: 'gold', text: 'Comisión liquidada · Oficina Manga · $19.2M', time: 'hace 1 h' },
      { tone: 'gold', text: 'Andrés Mejía pasó a Negociación', time: 'hace 4 h' },
      { tone: 'navy', text: 'Recordatorio · visita Penthouse mañana 10:00', time: 'ayer' },
    ],
  },
  prop: {
    user: 'María Elena V.', userRole: 'Propietaria', avatar: 'M',
    greeting: 'Hola, María Elena',
    subtitle: 'Tu apartamento en Castillogrande · en venta',
    tableTitle: 'Interesados en tu propiedad',
    kpis: [
      { label: 'Días publicado', value: '12', trend: '+12' },
      { label: 'Visitas realizadas', value: '14', trend: '+5' },
      { label: 'Interesados', value: '3', trend: '+2' },
      { label: 'Mejor oferta', value: '$1.400M', trend: '+3%' },
    ],
    rows: [
      { initials: 'VR', client: 'Valentina Ríos', inm: 'Tu apartamento', zona: 'Castillogrande', etapa: 'Negociación', tone: 'gold', valor: '$1.400M' },
      { initials: 'FO', client: 'Familia Osorio', inm: 'Tu apartamento', zona: 'Castillogrande', etapa: 'En visita', tone: 'gold', valor: '—' },
      { initials: 'IB', client: 'Inv. Bahía SAS', inm: 'Tu apartamento', zona: 'Castillogrande', etapa: 'Nuevo', tone: 'navy', valor: '—' },
    ],
    activities: [
      { tone: 'gold', text: 'Valentina Ríos hizo una oferta de $1.400M', time: 'hace 30 min' },
      { tone: 'gold', text: 'Nueva visita solicitada · Familia Osorio', time: 'hace 2 h' },
      { tone: 'navy', text: 'Tu avalúo fue actualizado por M. Restrepo', time: 'hace 1 día' },
      { tone: 'gold', text: 'Tu publicación alcanzó 1.240 vistas', time: 'hace 2 días' },
    ],
  },
};

// ── Opciones del formulario de ALTA (§108). Los valores salen del modelo SELLADO para que no puedan
//    divergir: si mañana `TIPOS_INMUEBLE` gana un tipo, el desplegable lo tiene sin tocar esta página.
const TIPOS: Array<[string, string]> = TIPOS_INMUEBLE.map((t) => [
  t,
  (t.charAt(0).toUpperCase() + t.slice(1)).replace(/_/g, ' '),
]);
const SPECS: Array<[string, string]> = [
  ['habitaciones', 'Habitaciones'],
  ['banos', 'Baños'],
  ['areaConstruidaM2', 'Área m²'],
  ['estrato', 'Estrato'],
  ['parqueaderos', 'Parqueaderos'],
  ['piso', 'Piso'],
];
const AMENIDADES = [
  'Piscina', 'Gimnasio', 'Ascensor', 'Portería 24h', 'Balcón',
  'Amoblado', 'Aire acondicionado', 'Terraza', 'Zona BBQ', 'Admite mascotas',
];
// El texto de cada estado dice su CONSECUENCIA, no su nombre. «Cerrado» es contraintuitivo a
// propósito: NO retira el inmueble (decisión de SEO), y elegirlo mal no produce ninguna señal.
const ESTADOS: Array<[string, string, string]> = [
  ['borrador', 'Borrador', 'Solo lo ve el equipo. Es lo que se guarda por defecto.'],
  ['disponible', 'Disponible', 'Sale al portal y a Google.'],
  ['reservado', 'Reservado', 'SIGUE saliendo en el portal, con el aviso puesto.'],
  ['cerrado', 'Vendido o arrendado', 'También SIGUE saliendo, con su aviso. Ayuda a que Google no pierda la página.'],
  ['inactivo', 'Inactivo', 'Desaparece del portal. Es el que retira el inmueble de verdad.'],
];

const roles = Object.keys(DATA);
// Solo los campos de texto por rol → se aplican con textContent (seguro, sin innerHTML).
const strings = Object.fromEntries(
  Object.entries(DATA).map(([r, d]) => [r, { user: d.user, userRole: d.userRole, avatar: d.avatar, greeting: d.greeting, subtitle: d.subtitle, tableTitle: d.tableTitle }])
);

const demand = [
  { zona: 'Bocagrande', pct: 92 },
  { zona: 'Castillogrande', pct: 85 },
  { zona: 'Centro Histórico', pct: 78 },
  { zona: 'Manga', pct: 64 },
];

const init = DATA.admin;
---

<BaseLayout title="Gestión — Panel ALTORRA" noindex>
  {/*
    PUERTA DE ACCESO (§98). El panel nace OCULTO y solo aparece cuando se ha comprobado que quien mira
    tiene sesión y el permiso de staff. Sin esto, la interfaz completa de administración se le enseñaba
    a cualquiera que escribiera la dirección.

    ⚠️ Y hay que decirlo con todas las letras: **esto NO es la frontera de seguridad**. Corre en el
    navegador y se salta con la consola abierta. La frontera real son las Security Rules de Firestore
    (`isStaff()`), que deciden qué documentos se dejan leer pase lo que pase en la página — y que
    todavía NO están desplegadas (TODO-17). Mientras el panel muestre datos DEMO no hay nada que
    filtrar; el día que lea datos reales, lo que lo protege son las Rules, no este script.
  */}
  <div class="gx-gate" id="gx-gate" role="status">
    <p class="gx-gate__t">Comprobando tu acceso…</p>
  </div>

  <div class="gx-gate" id="gx-denegado" hidden>
    <p class="gx-gate__t">Esta zona es del equipo de ALTORRA.</p>
    <p class="gx-gate__d">
      Entraste con <span id="gx-quien">tu cuenta</span>, pero no tiene permisos de gestión. Si crees que
      deberían dártelos, pídeselos a quien administra el portal.
    </p>
    <p class="gx-gate__d">
      Si te acaban de dar el acceso, tu sesión todavía lleva los permisos de antes: pulsa
      «Volver a comprobar».
    </p>
    <p class="gx-gate__acc">
      <button class="alt-btn alt-btn--navy" type="button" id="gx-reintentar">Volver a comprobar</button>
      <a class="alt-btn alt-btn--outline" href="/">Volver al portal</a>
      <button class="alt-btn alt-btn--outline" type="button" id="gx-salir">Salir de la sesión</button>
    </p>
  </div>

  <div class="gx-root" id="gx-panel" hidden>
    <!-- ===================== SIDEBAR ===================== -->
    <aside class="gx-side">
      <a class="gx-brand" href="/" aria-label="ALTORRA — volver al portal">
        <img src="/assets/altorra-emblema.webp" srcset={srcsetDe("/assets/altorra-emblema.webp")} sizes={SIZES.logo} alt="" width="31" height="42" />
        <span class="gx-brand__txt">
          <span class="gx-brand__name">ALTORRA</span>
          <span class="gx-brand__sub">GESTIÓN</span>
        </span>
      </a>

      <nav class="gx-nav" aria-label="Secciones de gestión">
        {nav.map((n) => (
          <a href="#" class={`gx-nav__item${n.active ? ' is-on' : ''}`} data-nav={n.id} data-pronto={'pronto' in n ? '1' : undefined} aria-current={n.active ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={n.icon}></svg>
            {n.label}
            {'pronto' in n && <span class="gx-nav__pronto">pronto</span>}
          </a>
        ))}
      </nav>

      {/* Lo que responde una sección que aún no existe. Vive pegado al menú, que es donde se hizo
          la pregunta: un aviso que aparece en otra parte de la pantalla no se ve. */}
      <p class="gx-nav__nota" id="gx-nav-nota" role="status" hidden></p>
      <script type="application/json" id="gx-nav-notas" set:html={JSON.stringify(NOTA_PRONTO)}></script>

      <div class="gx-me">
        <span class="gx-me__av" id="gx-avatar">{init.avatar}</span>
        <div class="gx-me__id">
          <div class="gx-me__name" id="gx-user">{init.user}</div>
          <div class="gx-me__role" id="gx-user-role">{init.userRole}</div>
        </div>
      </div>

      {/* La verificación en dos pasos se activa en «Mi seguridad», y el enlace vive AQUÍ —pegado a
          quién eres— porque una pantalla de seguridad que nadie encuentra es una que nadie usa. */}
      <a class="gx-me__seg" href="/seguridad">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.7l7.5 3v5.6c0 4.5-3.1 8.2-7.5 9.4-4.4-1.2-7.5-4.9-7.5-9.4V5.7z"/><path d="M9.3 12.1l1.9 1.9 3.6-3.7"/></svg>
        Mi seguridad
      </a>
    </aside>

    <!-- ===================== MAIN ===================== -->
    <main class="gx-main" id="main">
     <!-- Aviso de sesión a punto de cerrarse por inactividad (§130). Aparece 1 minuto antes, igual
          que en el panel viejo: cerrar sin avisar hace perder lo que se estuviera escribiendo.
          `role="status"` y no `alert`: es información, no una emergencia, y `alert` interrumpe al
          lector de pantalla a mitad de frase. -->
     <div class="gx-sesion" id="gx-aviso-sesion" role="status" hidden>
       <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 1.8"/></svg>
       <span>Tu sesión se cerrará en un minuto por inactividad. Mueve el ratón o escribe algo para seguir.</span>
     </div>

     <div id="gx-vista-panel">
      <header class="gx-head">
        <div>
          <h1 class="gx-greet" id="gx-greeting">{init.greeting}</h1>
          <p class="gx-sub" id="gx-subtitle">{init.subtitle}</p>
        </div>
        <div class="gx-head__actions">
          <div class="gx-seg" role="tablist" aria-label="Vista por rol">
            <button class="gx-seg__btn is-on" type="button" role="tab" aria-selected="true" data-role="admin">Admin</button>
            <button class="gx-seg__btn" type="button" role="tab" aria-selected="false" data-role="aliado">Aliado</button>
            <button class="gx-seg__btn" type="button" role="tab" aria-selected="false" data-role="prop">Propietario</button>
          </div>
          <button class="gx-new" type="button"><span aria-hidden="true">+</span>Nuevo inmueble</button>
        </div>
      </header>

      <!-- KPIs (una grilla por rol; solo la activa visible) -->
      <section class="gx-kpis">
        {roles.map((role) => (
          <div class="gx-kpi-set" data-set={role} hidden={role !== 'admin'}>
            {DATA[role as keyof typeof DATA].kpis.map((k, i) => (
              <div class="gx-kpi">
                <div class="gx-kpi__top">
                  <span class="gx-kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={KPI_ICONS[i]}></svg></span>
                  <span class="gx-kpi__trend"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" set:html={TREND}></svg>{k.trend}</span>
                </div>
                <div class="gx-kpi__val">{k.value}</div>
                <div class="gx-kpi__lbl">{k.label}</div>
              </div>
            ))}
          </div>
        ))}
      </section>

      <!-- Tabla + aside -->
      <section class="gx-grid">
        <div class="gx-panel gx-table">
          <div class="gx-panel__head">
            <h2 id="gx-table-title">{init.tableTitle}</h2>
            <div class="gx-head__actions">
              <button class="alt-btn alt-btn--ghost gx-btn-fila" type="button" id="gx-leads-export">Exportar CSV</button>
              <button class="gx-link gx-link--btn" type="button" id="gx-leads-vertodo">Ver todo &#8594;</button>
            </div>
          </div>
          {/* Lo que responde «Ver todo». La consulta está topada a 50 por doctrina de free-tier, así
              que la respuesta honesta depende de si ese tope se tocó o no — y se dice, en vez de
              fingir una paginación que no existe. */}
          <p class="gx-tabla-nota" id="gx-leads-nota" role="status" hidden></p>
          <div class="gx-scrollx">
            <div class="gx-table__inner">
              <div class="gx-tr gx-tr--head">
                <span>Cliente</span><span>Inmueble</span><span>Zona</span><span>Etapa</span><span class="gx-r">Valor</span>
              </div>
              {roles.map((role) => (
                <div class="gx-row-set" data-set={role} hidden={role !== 'admin'}>
                  {DATA[role as keyof typeof DATA].rows.map((r) => (
                    <div class="gx-tr">
                      <div class="gx-cli"><span class="gx-cli__ini">{r.initials}</span><span class="gx-cli__name">{r.client}</span></div>
                      <span class="gx-muted gx-ell">{r.inm}</span>
                      <span class="gx-muted">{r.zona}</span>
                      <span><span class={`gx-pill gx-pill--${r.tone}`}>{r.etapa}</span></span>
                      <span class="gx-val gx-r">{r.valor}</span>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="gx-col">
          <div class="gx-panel gx-pad">
            <h2>Actividad reciente</h2>
            {roles.map((role) => (
