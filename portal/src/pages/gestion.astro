          <div class="gx-estados">
            {ESTADOS.map((e, i) => (
              <label class={`gx-estado${i === 0 ? ' is-on' : ''}`}>
                <input type="radio" name="estado" value={e[0]} checked={i === 0} />
                <span><b>{e[1]}</b>{e[2]}</span>
              </label>
            ))}
          </div>
        </section>

        <div class="gx-pie">
          <p class="gx-pie__msg" id="gx-alta-msg" role="status" aria-live="polite"></p>
          <button class="alt-btn alt-btn--outline" type="button" id="gx-alta-cancelar">Cancelar</button>
          <button class="alt-btn alt-btn--navy" type="submit" id="gx-alta-guardar">Guardar inmueble</button>
        </div>
      </form>
     </div>
    </main>
  </div>

  <script type="application/json" id="gx-strings" set:html={JSON.stringify(strings)}></script>
</BaseLayout>

<!--
  ⚠️ LOS TRES BLOQUES DE ESTILO VAN `is:global` A PROPÓSITO (§117).

  Astro acota el CSS añadiendo `data-astro-cid-XXXX` a los elementos DE LA PLANTILLA y repitiéndolo
  en cada selector (`.gx-tr` compila a `.gx-tr[data-astro-cid-XXXX]`). Los nodos que crea el
  navegador en tiempo de ejecución —que aquí son CASI TODO: las filas de leads, inmuebles, agenda,
  contratos y cartera— no llevan ese atributo, así que NINGUNA regla les aplicaba. Se veían sin
  rejilla, sin tarjeta y con la tipografía del cuerpo, y nada fallaba: el CSS simplemente no
  existía para ellos.

  Se globaliza el bloque entero en vez de ir marcando `:global(...)` regla a regla porque esa lista
  habría que mantenerla cada vez que un script añade una clase nueva — y olvidarla no rompe el
  build, solo despinta la pantalla. El namespace `gx-` es el que acota: no aparece en ninguna otra
  página (`grep -rl "gx-" src/` → solo gestion.astro y sus cuatro scripts). Lo comprueba el gate
  `npm run verify:css`.
-->
<style is:global>
  /* Fila de MENSAJE de la tabla (vacío, cargando o error): ocupa el ancho y no parece un dato. */
  .gx-tr--msg { grid-template-columns: 1fr !important; padding-block: 22px; }
  .gx-tr--msg span { white-space: normal; }

  /* Puerta de acceso: pantalla completa, centrada, con la tipografía y la paleta del portal. */
  .gx-gate {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    padding: clamp(2rem, 6vw, 4rem) 1.25rem;
  }
  .gx-gate__t {
    font-family: var(--alt-font-display);
    font-weight: var(--alt-fw-semibold);
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    color: var(--alt-ink);
    margin: 0;
  }
  .gx-gate__d { color: var(--alt-text); max-width: 34rem; line-height: 1.6; margin: 0; }
  .gx-gate__acc { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0.75rem 0 0; }
</style>

