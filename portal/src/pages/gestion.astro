            <div data-solo="alojamiento" hidden>
              <label class="alt-label" for="a-precioNoche">Precio por noche</label>
              <input class="alt-input" id="a-precioNoche" name="precioNoche" type="text" inputmode="numeric" placeholder="$ 350.000" />
            </div>
          </div>
        </section>

        <section class="gx-panel gx-pad">
          <h2>Cómo es</h2>
          <p class="gx-psub">Lo que se deje en blanco simplemente no se muestra. No se inventa nada.</p>
          <div class="gx-fgrid gx-fgrid--corta">
            {SPECS.map((f) => (
              <div>
                <label class="alt-label" for={`a-${f[0]}`}>{f[1]}</label>
                <input class="alt-input" id={`a-${f[0]}`} name={f[0]} type="text" inputmode="numeric" />
              </div>
