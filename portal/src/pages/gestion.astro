          </div>
          <div class="gx-frow">
            <span class="alt-label">Amenidades</span>
            <div class="gx-chips" id="gx-alta-amenidades">
              {AMENIDADES.map((a) => (
                <button class="gx-chip" type="button" aria-pressed="false" data-amenidad={a}>{a}</button>
              ))}
            </div>
          </div>
        </section>

        <section class="gx-panel gx-pad">
          <h2>Fotos</h2>
          <p class="gx-psub">La primera es la portada: la que sale en el listado y al compartir por WhatsApp.</p>
          <div class="gx-fotos" id="gx-alta-fotos"></div>
          <label class="gx-subir" for="a-fotos">
            <span aria-hidden="true">+</span> Añadir fotos
            <input id="a-fotos" type="file" accept="image/*" multiple hidden />
