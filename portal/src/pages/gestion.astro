  /* ---- Main ---- */
  .gx-main { flex: 1 1 620px; min-width: 0; padding: clamp(20px, 3vw, 38px) clamp(18px, 3.4vw, 44px); display: flex; flex-direction: column; gap: clamp(20px, 2.4vw, 30px); }
  .gx-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; }
  .gx-greet { font-family: var(--alt-font-display); font-weight: var(--alt-fw-semibold); font-size: clamp(26px, 3.4vw, 38px); line-height: 1.05; color: var(--alt-ink); margin: 0 0 5px; letter-spacing: normal; }
  .gx-sub { font-size: 14px; color: var(--alt-text); margin: 0; }
  .gx-head__actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }

  .gx-seg { display: flex; background: var(--alt-white); border: 1px solid var(--alt-hairline); border-radius: var(--alt-r-sm); padding: 4px; gap: 2px; }
  .gx-seg__btn { flex: 1; padding: 9px 15px; border: none; border-radius: 9px; cursor: pointer; font-size: 13px; font-weight: var(--alt-fw-semibold); font-family: var(--alt-font-body); white-space: nowrap; background: transparent; color: var(--alt-text); transition: background var(--alt-dur-fast) var(--alt-ease), color var(--alt-dur-fast) var(--alt-ease); }
  .gx-seg__btn:hover { color: var(--alt-ink); }
  .gx-seg__btn.is-on { background: var(--alt-navy); color: #fff; }

  .gx-new { display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border-radius: var(--alt-r-sm); background: var(--alt-navy); color: #fff; font-weight: var(--alt-fw-semibold); font-size: 13.5px; font-family: var(--alt-font-body); border: none; cursor: pointer; white-space: nowrap; transition: box-shadow var(--alt-dur) var(--alt-ease), transform var(--alt-dur) var(--alt-ease); }
  .gx-new span { font-size: 17px; line-height: 1; color: var(--alt-gold-bright); }
  .gx-new:hover { box-shadow: var(--alt-elev-nav-scroll); transform: translateY(-1px); }

  /* ---- KPIs ---- */
  .gx-kpi-set { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr)); gap: 16px; }
  .gx-kpi-set[hidden] { display: none; }
  .gx-kpi { background: var(--alt-white); border: 1px solid var(--alt-hairline); border-radius: var(--alt-r-md); padding: 20px 22px; box-shadow: var(--alt-elev-panel); animation: gx-rise 0.5s var(--alt-ease) both; }
  .gx-kpi__top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
  .gx-kpi__ic { width: 38px; height: 38px; border-radius: var(--alt-r-sm); background: var(--alt-mist); display: flex; align-items: center; justify-content: center; color: var(--alt-ink); }
  .gx-kpi__ic svg { width: 18px; height: 18px; }
  .gx-kpi__trend { display: inline-flex; align-items: center; gap: 4px; padding: 4px 9px; border-radius: var(--alt-r-pill); background: var(--alt-mist); font-size: 11px; font-weight: var(--alt-fw-bold); color: var(--alt-link); }
  .gx-kpi__trend svg { width: 11px; height: 11px; }
  .gx-kpi__val { font-family: var(--alt-font-display); font-weight: var(--alt-fw-semibold); font-size: 34px; line-height: 1; color: var(--alt-ink); margin-bottom: 5px; }
  .gx-kpi__lbl { font-size: 12.5px; color: var(--alt-text); font-weight: var(--alt-fw-medium); }

  /* ---- Grid tabla + aside ---- */
  .gx-grid { display: flex; gap: clamp(18px, 2vw, 26px); flex-wrap: wrap; align-items: flex-start; }
  .gx-panel { background: var(--alt-white); border: 1px solid var(--alt-hairline); border-radius: var(--alt-r-lg); box-shadow: var(--alt-elev-panel); }
  .gx-pad { padding: 22px 24px; }
  .gx-table { flex: 2 1 460px; min-width: 0; overflow: hidden; }
  .gx-col { flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .gx-panel__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 22px 24px 16px; }
  .gx-panel h2 { font-family: var(--alt-font-display); font-weight: var(--alt-fw-semibold); font-size: 22px; color: var(--alt-ink); margin: 0; letter-spacing: normal; }
  .gx-col .gx-panel h2 { font-size: 20px; margin-bottom: 18px; }
  .gx-link { font-size: 13px; font-weight: var(--alt-fw-semibold); color: var(--alt-link); white-space: nowrap; text-decoration: none; }
  .gx-link:hover { text-decoration: underline; }
  /* «Ver todo» era un `<a href="#">` sin nadie que lo escuchara: pulsarlo no hacía nada y encima
     saltaba al principio de la página. Ahora es un botón —que es lo que siempre fue— y responde. */
  .gx-link--btn { border: 0; background: none; padding: 0; font-family: inherit; cursor: pointer; }
  .gx-tabla-nota { margin: 0 clamp(14px, 2vw, 22px) 14px; padding: 9px 12px; border-radius: var(--alt-r-sm); background: var(--alt-mist); border-left: 2px solid var(--alt-gold); color: var(--alt-text-soft); font-size: 12.5px; line-height: 1.6; }
  .gx-tabla-nota[hidden] { display: none; }

  .gx-scrollx { overflow-x: auto; }
  .gx-scrollx::-webkit-scrollbar { height: 8px; }
  .gx-scrollx::-webkit-scrollbar-thumb { background: var(--alt-hairline-2); border-radius: 8px; }
  .gx-table__inner { min-width: 660px; }
  .gx-row-set[hidden] { display: none; }
  .gx-tr { display: grid; grid-template-columns: 1.7fr 1.5fr 1fr 1.1fr 1fr; gap: 12px; padding: 14px 24px; border-bottom: 1px solid var(--alt-hairline); align-items: center; }
  .gx-tr--head { padding: 10px 24px; border-top: 1px solid var(--alt-hairline); font-size: 10.5px; font-weight: var(--alt-fw-bold); letter-spacing: 0.1em; text-transform: uppercase; color: var(--alt-text-muted); }
  .gx-r { text-align: right; }
  .gx-cli { display: flex; align-items: center; gap: 10px; min-width: 0; }
  /* En la cartera la celda no lleva avatar sino CÓDIGO + concepto, y en fila los dos se estorban:
     «Giro al propietario» pedía 112px de los 99 que le quedaban. Apilados cada uno tiene la
     columna entera, y es la forma habitual de una celda con identificador y subtítulo. */
  .gx-cli--apilada { flex-direction: column; align-items: flex-start; gap: 2px; }
  .gx-cli__ini { width: 34px; height: 34px; border-radius: 50%; background: var(--alt-mist); display: flex; align-items: center; justify-content: center; flex: none; font-size: 12px; font-weight: var(--alt-fw-semibold); color: var(--alt-ink); }
  .gx-cli__name { font-size: 13.5px; font-weight: var(--alt-fw-semibold); color: var(--alt-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .gx-muted { font-size: 13px; color: var(--alt-text); }
  .gx-ell { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* Para las celdas que dan una INSTRUCCIÓN, no un identificador: cortar «Preaviso de terminación
     por mora. Escrito, con constancia…» deja al operador sin la mitad que le dice qué hacer.
     Dos líneas caben de sobra; los códigos y los rangos de fecha siguen con `gx-ell`. */
  .gx-wrap { white-space: normal; line-height: 1.35; }
  .gx-val { font-size: 13.5px; font-weight: var(--alt-fw-semibold); color: var(--alt-ink); white-space: nowrap; }
  .gx-pill { display: inline-flex; align-items: center; padding: 5px 11px; border-radius: var(--alt-r-pill); font-size: 11.5px; font-weight: var(--alt-fw-semibold); background: var(--alt-mist); }
  .gx-pill--gold { color: var(--alt-link); }
  .gx-pill--navy { color: var(--alt-ink); }

  /* ---- Actividad ---- */
  .gx-act-set { display: flex; flex-direction: column; gap: 16px; }
  .gx-act-set[hidden] { display: none; }
  .gx-act { display: flex; gap: 13px; }
  .gx-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; margin-top: 5px; }
  .gx-dot--gold { background: var(--alt-gold-raw); }
  .gx-dot--navy { background: var(--alt-ink); }
  .gx-act__txt { font-size: 13.5px; font-weight: var(--alt-fw-semibold); color: var(--alt-ink); line-height: 1.35; }
  .gx-act__time { font-size: 12px; color: var(--alt-text-muted); margin-top: 2px; }

  /* ---- Demanda ---- */
  .gx-dem { display: flex; flex-direction: column; gap: 14px; }
  .gx-dem__lbl { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--alt-text); margin-bottom: 6px; }
  .gx-dem__lbl span:first-child { font-weight: var(--alt-fw-medium); }
  .gx-dem__track { height: 6px; border-radius: 6px; background: var(--alt-gris-claro); position: relative; }
  .gx-dem__fill { position: absolute; left: 0; top: 0; bottom: 0; background: linear-gradient(90deg, var(--alt-gold), var(--alt-navy)); border-radius: 6px; }

  @keyframes gx-rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .gx-kpi { animation: none; } }

  @media (max-width: 860px) {
    .gx-side { flex-basis: 100%; height: auto; position: static; flex-direction: row; align-items: center; flex-wrap: wrap; gap: 10px; padding: 14px 18px; }
    .gx-brand { padding: 0; }
    .gx-nav { flex-direction: row; flex-wrap: wrap; margin-top: 0; margin-inline: auto; }
    .gx-nav__item { padding: 9px 11px; }
    .gx-me { margin-top: 0; border-top: 0; padding: 0; }
  }
</style>

<style is:global>
  .gx-table__inner--vf .gx-tr { grid-template-columns: 2.2fr 3fr 1fr; align-items: center; }

  /* BÓVEDA (§142). Estas reglas se escriben A LA VEZ que el JavaScript que crea las filas: una clase
     sin regla no falla, solo despinta — y eso es exactamente lo que costó §117 y §133. */
  .gx-table__inner--doc .gx-tr { grid-template-columns: 1.8fr 3fr 1fr auto; align-items: center; }
  .gx-doc-fila--aviso { background: var(--alt-mist); border-left: 3px solid var(--alt-gold); }
  /* Vencido = navy con más peso + el dato al lado. NO rojo: la paleta no lo tiene, y el color por sí
     solo tampoco sirve a quien no lo distingue (el texto ya dice «venció hace 5 meses»). */
  .gx-doc-vencido { color: var(--alt-ink); font-weight: var(--alt-fw-semibold); }
  .gx-doc-check { display: flex; gap: 11px; align-items: flex-start; margin-top: 4px; padding: 13px 15px; border-radius: var(--alt-r-sm); background: var(--alt-mist); border-left: 3px solid var(--alt-gold); font-size: 13px; line-height: 1.65; color: var(--alt-text-soft); }
  .gx-doc-check input { margin-top: 2px; flex: none; }
  .gx-table__inner--docdet .gx-tr { grid-template-columns: 2fr 2.6fr auto; align-items: center; }
  /* Un hueco pesa lo mismo que un archivo: si el que falta se viera más flojo, se leería como opcional. */
  .gx-doc-falta { background: var(--alt-mist); border-left: 3px solid var(--alt-gold); }
  .gx-doc-acc { display: inline-flex; gap: 12px; }
  /* Bitácora de un documento (§148, artboard 4a). Nace plegada y se sangra bajo su fila para que se
     lea como parte de ella y no como una fila más de la tabla. */
  .gx-doc-bit { padding: 14px 18px 14px 34px; border-left: 3px solid var(--alt-gold); background: var(--alt-mist); }
  .gx-doc-bit__aviso { margin: 0 0 12px; font-size: 13px; line-height: 1.65; color: var(--alt-text); }
  .gx-doc-bit__aviso strong { color: var(--alt-ink); font-weight: var(--alt-fw-semibold); }
  .gx-doc-bit__k { margin: 0 0 8px; font-size: 11px; font-weight: var(--alt-fw-bold); letter-spacing: 0.1em; text-transform: uppercase; color: var(--alt-text-soft); }
  /* VENTAS (§151). La escalera de 7 peldaños: cumplidos en navy, el actual en oro, los que faltan en
     plata. Solo el actual lleva su explicación — repetirla en los siete esconde la línea que hay que
     leer. */
  .gx-vta-escalera { display: flex; flex-direction: column; gap: 2px; margin: 16px 0 20px; }
  .gx-vta-paso { display: flex; gap: 14px; align-items: flex-start; padding: 8px 0; }
  .gx-vta-paso__n { width: 22px; height: 22px; border-radius: var(--alt-r-circle); background: var(--alt-surface-neu); color: var(--alt-text-soft); font-size: 11px; font-weight: var(--alt-fw-bold); display: flex; align-items: center; justify-content: center; flex: none; }
  .gx-vta-paso.is-hecho .gx-vta-paso__n { background: var(--alt-ink); color: #fff; }
  .gx-vta-paso.is-on .gx-vta-paso__n { background: var(--alt-gold); color: var(--alt-ink); }
  .gx-vta-paso__t { font-size: 14px; font-weight: var(--alt-fw-semibold); color: var(--alt-text-soft); }
  .gx-vta-paso.is-hecho .gx-vta-paso__t, .gx-vta-paso.is-on .gx-vta-paso__t { color: var(--alt-ink); }
  .gx-vta-paso__d { font-size: 12.5px; line-height: 1.55; color: var(--alt-text); margin-top: 2px; }
  .gx-vta-acciones { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-bottom: 20px; }
  /* La fila que hay que mirar HOY. Filete de oro, no rojo: el riesgo se dice con la paleta. */
  .gx-vta-alerta { background: var(--alt-mist); border-left: 3px solid var(--alt-gold); }
  .gx-doc-bit__fila { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 14px; padding: 9px 0; border-top: 1px solid var(--alt-hairline); font-size: 13px; }
  .gx-btn-fila { padding: 7px 15px; font-size: 13px; }
  .gx-pad-x { padding-inline: 20px; }

  .gx-table__inner--ex .gx-tr { grid-template-columns: 2.2fr 1fr 2.6fr; }
  .gx-table__inner--nv .gx-tr { grid-template-columns: 1.9fr 1.2fr 1fr 0.7fr 2.2fr; }
  /* Campo que ocupa la fila entera: una descripción de una frase en un tercio de ancho se lee peor
     que el problema que describe. Un solo nombre — `span 2` daba EXACTAMENTE lo mismo en esta
     rejilla, y dos clases para un mismo resultado es como empieza a pudrirse una hoja de estilos. */
  .gx-ancho { grid-column: 1 / -1; }

  .gx-table__inner--pg .gx-tr { grid-template-columns: 1.6fr 1fr 1.1fr 1.2fr 2fr; }

  /* ══ CONTRATOS (§114) ════════════════════════════════════════════════════════════════════ */
  .gx-table__inner--agenda .gx-tr { grid-template-columns: 2fr 1fr 1fr 2.4fr; }
  .gx-table__inner--ct .gx-tr { grid-template-columns: 2fr 1fr 1.2fr 1fr 1.6fr; }
  .gx-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--alt-text); margin-bottom: 8px; }
  .gx-check input { accent-color: var(--alt-surface-ink); }
  /* El aviso del formulario ocupa el hueco del pie y solo aparece cuando tiene algo que decir. */
  .gx-aviso--form { flex: 1 1 280px; margin: 0; font-size: 13px; }
  .gx-aviso--form:empty { display: none; }
  .gx-aviso--form ul { margin: 0; padding-left: 18px; color: var(--alt-text-soft); line-height: 1.6; }

  /* ══ LISTADO DE INMUEBLES (§110) ═════════════════════════════════════════════════════════ */
  .gx-table__inner--inm .gx-tr { grid-template-columns: 2.2fr 1fr 1.4fr 1.1fr 1fr; }
  .gx-cod {
    display: block;
    font-size: 11px;
    font-weight: var(--alt-fw-semibold);
    letter-spacing: 0.04em;
    color: var(--alt-text-muted);
  }
  /* «No se ve» en ORO: en esta paleta el oro es lo que pide atención, y el rojo no existe. */
  .gx-vis__no { color: var(--alt-link); font-weight: var(--alt-fw-semibold); font-size: 13px; cursor: help; }
  /* La fila entera abre el inmueble a editar. Con foco visible: se puede recorrer con el teclado. */
  .gx-tr--click { cursor: pointer; transition: background var(--alt-dur-fast) var(--alt-ease); }
  .gx-tr--click:hover { background: var(--alt-mist); }
  .gx-tr--click:focus-visible { outline: 2px solid var(--alt-gold); outline-offset: -2px; }

  /* ══ PANTALLA «NUEVO INMUEBLE» (§108) ══════════════════════════════════════════════════════
     Todo sale de `tokens.css`. Ni un color suelto: la paleta es navy / dorado / plata / blanco, y
     los estados NO usan verde ni rojo — la jerarquía se hace con oro (pide acción) y navy (reposo). */

  .gx-volver {
    background: none;
    border: 0;
    padding: 0 0 6px;
    font: inherit;
    font-size: 12.5px;
    font-weight: var(--alt-fw-semibold);
    color: var(--alt-link);
    cursor: pointer;
  }
  .gx-volver:hover { text-decoration: underline; }

  .gx-form { display: flex; flex-direction: column; gap: clamp(16px, 2vw, 22px); }
  /* El `h2` de `.gx-panel` computa margen 0 aquí, así que el subtítulo necesita separación POSITIVA.
     El `-10px` que había asumía un margen que no existe y montaba el texto encima del título. */
  .gx-psub { font-size: 12.5px; color: var(--alt-text-soft); margin: 5px 0 18px; }

  .gx-fgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    gap: 16px;
  }
  .gx-fgrid + .gx-fgrid { margin-top: 16px; }
  .gx-fgrid--corta { grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr)); }
  .gx-frow { margin-top: 16px; }
  .gx-hint { font-size: 11.5px; color: var(--alt-text-soft); margin: 6px 0 0; line-height: 1.45; }
  /* Celda de la rejilla que solo lleva una nota: se alinea ABAJO, a la altura de los campos vecinos.
     El `align-self` tiene que ir en la CELDA (el `div`), no en el párrafo — que es lo que fallaba: el
     elemento de la rejilla es el contenedor, y el hijo no hereda su alineación. */
  .gx-celda-nota { display: flex; align-items: flex-end; }
  .gx-celda-nota .gx-hint { margin: 0 0 13px; }
  .gx-ta { font-family: inherit; resize: vertical; }

  /* Aviso de visibilidad: filo de oro, igual que el disclaimer de `/publicar`. Se lee como una nota
     honesta, no como una alarma — porque «es un borrador» no es un error. */
  .gx-aviso {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    background: var(--alt-surface);
    border: 1px solid var(--alt-hairline);
    border-left: 3px solid var(--alt-gold);
    border-radius: 14px;
    padding: 15px 18px;
    margin-bottom: 4px;
  }
  .gx-aviso__t { font-size: 13.5px; font-weight: var(--alt-fw-semibold); color: var(--alt-ink); margin: 0 0 5px; }
  .gx-aviso ul { margin: 0; padding-left: 17px; font-size: 13px; color: var(--alt-text-soft); line-height: 1.65; }

  /* Amenidades: píldora navy cuando está puesta, contorno cuando no. Mismo patrón que los chips del SERP. */
  .gx-chips { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 10px; }
  .gx-chip {
    padding: 8px 15px;
    border-radius: 999px;
    border: 1px solid var(--alt-hairline-2);
    background: var(--alt-surface);
    color: var(--alt-text-soft);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: background .2s, color .2s, border-color .2s;
  }
  .gx-chip[aria-pressed='true'] {
    background: var(--alt-surface-ink);
    border-color: var(--alt-surface-ink);
    color: #fff;
    font-weight: var(--alt-fw-medium);
  }

  /* Galería: la primera lleva el sello de PORTADA porque es la que decide la tarjeta y el enlace
     compartido — no es decoración, es la consecuencia del orden. */
  .gx-fotos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr));
    gap: 14px;
    margin-bottom: 14px;
  }
  .gx-fotos:empty { display: none; }
  .gx-foto { position: relative; aspect-ratio: 4 / 3; border-radius: 13px; overflow: hidden; background: var(--alt-mist); }
  .gx-foto img { width: 100%; height: 100%; object-fit: cover; }
  .gx-foto__sello {
    position: absolute; top: 9px; left: 9px;
    padding: 4px 10px; border-radius: 999px;
    background: var(--alt-gold); color: var(--alt-surface-ink);
    font-size: 10.5px; font-weight: var(--alt-fw-bold); letter-spacing: .04em;
  }
  .gx-foto__x {
    position: absolute; top: 8px; right: 8px;
    width: 26px; height: 26px; border-radius: 50%;
    border: 0; background: rgba(6, 39, 67, .82); color: #fff;
    font-size: 15px; line-height: 1; cursor: pointer;
  }
  .gx-foto--subiendo { display: flex; align-items: center; justify-content: center; }
  .gx-foto--subiendo span { font-size: 12px; color: var(--alt-text-soft); }

  .gx-subir {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 18px; border-radius: 12px;
    border: 1px dashed var(--alt-hairline-2);
    background: var(--alt-surface);
    color: var(--alt-text-soft);
    font-size: 13.5px; cursor: pointer;
  }
  .gx-subir span { font-size: 19px; line-height: 1; color: var(--alt-link); }

  .gx-estados { display: flex; flex-direction: column; gap: 11px; }
  .gx-estado {
    display: flex; gap: 12px; align-items: flex-start;
    padding: 14px 17px; border: 1px solid var(--alt-hairline-2);
    border-radius: 13px; cursor: pointer;
  }
  .gx-estado.is-on { border-color: var(--alt-surface-ink); background: var(--alt-mist); }
  .gx-estado input { margin-top: 3px; accent-color: var(--alt-surface-ink); }
  .gx-estado b { display: block; font-size: 14px; color: var(--alt-ink); }
  .gx-estado span { font-size: 12.5px; color: var(--alt-text-soft); line-height: 1.5; }

  .gx-pie { display: flex; justify-content: flex-end; align-items: center; gap: 12px; flex-wrap: wrap; padding-bottom: 12px; }
  .gx-pie__msg { flex: 1 1 220px; margin: 0; font-size: 13px; color: var(--alt-text-soft); }
  .gx-pie__msg:empty { display: none; }

  /* Error de campo: el borde se pone dorado, no rojo (la paleta no tiene rojo), y el texto va debajo
     del campo que lo causa — no en una lista al final que obliga a buscarlo. */
  /* Anclada a `.gx-root`: `.alt-input` es del design system y con el bloque global esta regla
     se aplicaría a TODO el sitio. `is-mal` la pone el script, por eso vive aquí y no en base. */
  .gx-root .alt-input.is-mal { border-color: var(--alt-gold); }
  .gx-err { font-size: 12px; color: var(--alt-link); margin: 5px 0 0; font-weight: var(--alt-fw-medium); }

  /* ── Aviso de sesión por inactividad (§130) ────────────────────────────────────────────────
     Navy sobre franja clara con filo dorado: la paleta no tiene rojo, y de todas formas esto no es
     una alarma — es un aviso a tiempo. */
  .gx-sesion {
    grid-column: 1 / -1;
    display: flex; align-items: center; gap: 10px;
    margin: 0 0 var(--alt-space-4);
    padding: 12px 16px; border-radius: 12px;
    background: var(--alt-surface-alt); border-left: 3px solid var(--alt-gold);
    font-size: 13.5px; color: var(--alt-ink);
  }
  .gx-sesion svg { flex: 0 0 auto; color: var(--alt-link-lg); }
  .gx-sesion[hidden] { display: none; }

  /* ── El panel según el ROL (§130) ──────────────────────────────────────────────────────────
     Quien entra con acceso de SOLO CONSULTA no ve los controles que escriben. Antes los veía todos
     y la base se los rechazaba, que es la peor combinación: parece roto en vez de parecer vedado.

     Se cuelga de `body[data-puede-editar]`, que pone el script al abrir el panel, y NO de una clase
     por elemento. Así una pantalla nueva hereda la regla sin que nadie se acuerde de añadirla — que
     es exactamente la clase de olvido que produce estos huecos.

     ⚠️ SIN `:global()`, y no por gusto: este bloque ya es `<style is:global>`, y ahí Astro NO procesa
     esa función — la deja escrita tal cual en el CSS servido. El navegador no sabe leerla y descarta
     la regla ENTERA, en silencio. Lo escribí con `:global()` por costumbre, compiló sin una queja,
     los cuatro gates pasaron, y solo apareció al mirar el CSS de verdad (§130, familia de §117).

     ⚠️ Esto decide qué se DIBUJA. Quien impide de verdad la escritura es la Security Rule
     (`esEditorOMas()`), que ya la denegaba y la sigue denegando. Ocultar no es proteger. */
  body[data-puede-editar='false'] .gx-form,
  body[data-puede-editar='false'] .gx-new,
  body[data-puede-editar='false'] #gx-vista-alta { display: none; }

  /* ═══ LIQUIDACIÓN (§167) — el comprobante del mes ═══
     `is:global` como el resto del panel (§117): estas clases las crea el JS con `createElement`, y una
     regla acotada por Astro no alcanza a un nodo sin el atributo `data-astro-cid-*`. */
  .gx-liq__barra { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; padding: 18px 20px; margin-bottom: 16px; }
  .gx-liq__campo { flex: 1 1 300px; display: block; }
  .gx-liq__campo > span { display: block; font-size: 12px; font-weight: 600; color: var(--gx-navy, #062743); margin-bottom: 6px; }
  .gx-liq__campo select { width: 100%; padding: 11px 12px; border: 1px solid #DDE4EA; border-radius: 10px; font: inherit; font-size: 14px; color: var(--gx-navy, #062743); background: #fff; }
  .gx-liq__check { flex: 1 1 340px; display: flex; align-items: flex-start; gap: 9px; font-size: 13.5px; line-height: 1.55; color: #5B6572; cursor: pointer; }
  .gx-liq__check input { margin-top: 3px; flex: none; }
  .gx-liq__check em { font-style: normal; color: #8A94A0; }

  .gx-liq { padding: 28px 30px; }
  .gx-liq__msg { margin: 0; font-size: 14px; color: #8A94A0; }

  .gx-liq__top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-bottom: 18px; border-bottom: 1px solid #EDF1F5; }
  .gx-liq__top-t { margin: 0; font-size: 16px; font-weight: 600; color: var(--gx-navy, #062743); }
  .gx-liq__top-d { margin: 4px 0 0; font-size: 13px; color: #8A94A0; }
  .gx-liq__top-n { margin: 0; font-family: 'Cormorant Garamond', serif; font-size: 30px; font-weight: 600; color: var(--gx-navy, #062743); white-space: nowrap; }

  .gx-liq__eyebrow { margin: 22px 0 10px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: #8A94A0; font-weight: 600; }

  .gx-liq__fila { display: flex; justify-content: space-between; gap: 16px; padding: 13px 0; border-bottom: 1px solid #F4F7F9; }
  /* La línea que NO aplica se apaga, no se esconde: enseñarla es la mitad del punto (§167). */
  .gx-liq__fila--nula { background: #FBFCFD; margin: 0 -12px; padding-left: 12px; padding-right: 12px; border-radius: 8px; }
  .gx-liq__fila--nula .gx-liq__concepto, .gx-liq__fila--nula .gx-liq__monto { color: #5B6572; }
  .gx-liq__concepto { font-size: 14.5px; color: var(--gx-navy, #062743); font-weight: 500; }
  .gx-liq__destino { display: block; font-size: 12.5px; color: #8A94A0; margin-top: 2px; }
  .gx-liq__destino strong { color: var(--gx-navy, #062743); }
  .gx-liq__monto { font-size: 15px; color: var(--gx-navy, #062743); white-space: nowrap; }

  .gx-liq__giro { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-top: 20px; padding: 20px 22px; background: var(--gx-navy, #062743); border-radius: 14px; }
  .gx-liq__giro-t { margin: 0; font-size: 15px; font-weight: 600; color: #fff; }
  .gx-liq__giro-d { margin: 4px 0 0; font-size: 12.5px; color: #BFC3C9; }
  .gx-liq__giro-n { margin: 0; font-family: 'Cormorant Garamond', serif; font-size: 32px; font-weight: 600; color: #d4af37; white-space: nowrap; }

  .gx-liq__cuadre { margin: 16px 0 0; padding-top: 14px; border-top: 1px dashed #DDE4EA; font-size: 12.5px; line-height: 1.7; color: #8A94A0; }
  .gx-liq__cuadre strong { color: var(--gx-navy, #062743); }
  /* Si no cuadrara, se ve en ORO y no en rojo: la disciplina de color de la marca no tiene rojo, y
     un descuadre es un aviso para parar, no un error del sistema. */
  .gx-liq__cuadre--mal { border-top: 2px solid #d4af37; color: var(--gx-navy, #062743); font-weight: 500; }

  .gx-liq__problemas { border-left: 3px solid #d4af37; padding: 4px 0 4px 18px; }
  .gx-liq__problemas-t { margin: 0 0 8px; font-size: 15px; font-weight: 600; color: var(--gx-navy, #062743); }
  .gx-liq__problemas-d { margin: 0 0 6px; font-size: 13.5px; line-height: 1.65; color: #5B6572; }

  .gx-liq__nota { margin-top: 18px; border-left: 3px solid #d4af37; background: #fff; border-radius: 0 14px 14px 0; padding: 16px 20px; }
  .gx-liq__nota p { margin: 0; font-size: 13.5px; line-height: 1.75; color: #5B6572; }
  .gx-liq__nota strong { color: var(--gx-navy, #062743); }

  @media (max-width: 620px) {
    .gx-liq { padding: 20px 18px; }
    .gx-liq__top, .gx-liq__giro, .gx-liq__fila { flex-direction: column; align-items: flex-start; gap: 6px; }
  }
</style>

<script>
  /*
   * PUERTA DE ACCESO del panel (§98). Ver la nota del markup: esto es UX y disuasión, no seguridad.
   * La frontera real son las Security Rules; aquí solo se decide qué se le enseña a quién.
   *
   * El orden importa: se ESPERA a que Firebase restaure la sesión antes de decidir. Leer el usuario
   * sin esperar devuelve `null` en la primera pintura aunque la persona esté dentro, y el panel la
   * echaría al login cada vez que recarga — el error clásico de esta API.
   */
  import { estadoAcceso, salir, type EstadoAcceso } from '../scripts/auth';
  import { montarExportLeads, montarLeads, montarVerTodoLeads } from '../scripts/gestion-leads';
  import { montarAlta } from '../scripts/gestion-alta-ui';

  const puerta = document.getElementById('gx-gate');
  const denegado = document.getElementById('gx-denegado');
  const panel = document.getElementById('gx-panel');

  function mostrar(cual: HTMLElement | null): void {
    for (const n of [puerta, denegado, panel]) if (n) n.hidden = n !== cual;
  }

  document.getElementById('gx-salir')?.addEventListener('click', () => void salir());

  /* ── El panel según el ROL (§130) ────────────────────────────────────────────────────────────
   * Antes, este panel solo preguntaba «¿eres del equipo?». Quien tuviera acceso de SOLO CONSULTA
   * veía la misma pantalla que el dueño: los formularios de alta, los botones de guardar, todo. La
   * base se lo habría denegado —esa parte sí estaba bien— pero la interfaz se lo ofrecía igual, y una
   * interfaz que ofrece lo que la base va a rechazar enseña a la gente que el sistema está roto.
   *
   * Se marca en el `<body>` con `data-rol` en vez de recorrer nodos: así el CSS oculta lo que toque
   * en la misma pintura, sin parpadeo, y una pantalla nueva hereda la regla sin acordarse de nada.
   */
  const NOMBRE_ROL: Record<string, string> = {
    super_admin: 'Administrador',
    editor: 'Editor',
    viewer: 'Solo consulta',
  };

  function aplicarRol(r: Extract<EstadoAcceso, { estado: 'staff' }>): void {
    document.body.dataset.rol = r.rol;
    document.body.dataset.puedeEditar = String(r.puedeEditar);

    // Se reutilizan los huecos que ya existían en la barra lateral —traían el nombre de DEMO— en vez
    // de añadir otros: dos sitios distintos diciendo quién eres acaban contradiciéndose.
    const rolEl = document.getElementById('gx-user-role');
    if (rolEl) rolEl.textContent = NOMBRE_ROL[r.rol] || r.rol;
    const nombreEl = document.getElementById('gx-user');
    const avatarEl = document.getElementById('gx-avatar');
    if (r.email) {
      const usuario = r.email.split('@')[0];
      if (nombreEl) { nombreEl.textContent = usuario; nombreEl.title = r.email; }
      if (avatarEl) avatarEl.textContent = usuario.charAt(0).toUpperCase();
    }
  }

  /* ── Corte por inactividad (§130) ────────────────────────────────────────────────────────────
   * El panel VIEJO cerraba la sesión a los 30 minutos sin actividad y avisaba un minuto antes. Al
   * mudarnos al portal eso se perdió por el camino y nadie lo notó — es de las funciones que solo se
   * echan de menos el día que hacen falta. Aquí abre contratos y cédulas escaneadas: un panel
   * abierto en una pantalla que alguien dejó sola es la fuga más barata que existe.
   */
  const INACTIVIDAD_MS = 30 * 60 * 1000;
  const AVISO_MS = 60 * 1000;
  let tempCierre: number | undefined;
  let tempAviso: number | undefined;

  function reiniciarInactividad(): void {
    window.clearTimeout(tempCierre);
    window.clearTimeout(tempAviso);
    document.getElementById('gx-aviso-sesion')?.setAttribute('hidden', '');
    tempAviso = window.setTimeout(() => {
      document.getElementById('gx-aviso-sesion')?.removeAttribute('hidden');
    }, INACTIVIDAD_MS - AVISO_MS);
    tempCierre = window.setTimeout(() => void salir(), INACTIVIDAD_MS);
  }

  function vigilarInactividad(): void {
    // `passive` porque ninguno de estos necesita cancelar el evento, y sin él el navegador no puede
    // adelantar el desplazamiento — se nota en móvil.
    for (const ev of ['pointerdown', 'keydown', 'scroll', 'touchstart'] as const) {
      document.addEventListener(ev, reiniciarInactividad, { passive: true });
    }
    reiniciarInactividad();
  }

  /** Todo lo que hay que encender cuando ya se sabe que quien mira es del equipo. */
  function abrirPanel(r: Extract<EstadoAcceso, { estado: 'staff' }>): void {
    aplicarRol(r);
    mostrar(panel);
    vigilarInactividad();
    // Los datos REALES solo se piden cuando ya se sabe que quien mira es del equipo: pedir algo que
    // las Rules van a denegar solo ensucia la consola y confunde al siguiente que la mire.
    void montarLeads();
    /*
     * ⚠️ SE MONTA SIEMPRE, y antes NO. Aquí ponía `if (r.puedeEditar) montarAlta()`, y dentro de esa
     * función vive —además del formulario de alta— **el enrutador de la barra lateral**. Consecuencia:
     * a quien entra en modo «solo consulta» no se le cableaba el menú y NINGUNA sección respondía.
     * Un panel entero mudo por una condición pensada para otra cosa.
     *
     * Navegar no es editar. Lo que impide escribir a un `viewer` sigue en pie y son las capas que de
     * verdad mandan: las Security Rules (servidor), el CSS que esconde los controles de edición
     * (`body[data-puede-editar='false']`), y la guarda dentro del propio botón «+ Nuevo inmueble».
     * No cablear el código nunca fue una de esas capas — era un efecto colateral.
     */
    montarAlta();
  }

  /* Volver a comprobar FORZANDO el refresco del token. Los claims viajan dentro del token y este se
     renueva cada hora, así que sin esto a quien le acaban de dar permiso le tocaba esperar o cerrar
     sesión — y lo más probable es que pensara que algo estaba roto. */
  montarExportLeads();
  montarVerTodoLeads();
  const reintentar = document.getElementById('gx-reintentar') as HTMLButtonElement | null;
  reintentar?.addEventListener('click', async () => {
    reintentar.disabled = true;
    reintentar.textContent = 'Comprobando…';
    const r = await estadoAcceso(true).catch(() => null);
    if (r?.estado === 'staff') {
      abrirPanel(r);
      return;
    }
    reintentar.disabled = false;
    reintentar.textContent = 'Volver a comprobar';
  });

  estadoAcceso()
    .then((r) => {
      if (r.estado === 'anonimo') {
        // `volver` para que el login devuelva AQUÍ y no a favoritos: quien venía a gestionar no
        // quiere acabar en su lista de favoritos después de escribir la contraseña.
        window.location.href = '/ingresar?volver=' + encodeURIComponent('/gestion');
        return;
      }
      if (r.estado === 'sin-permiso') {
        const quien = document.getElementById('gx-quien');
        if (quien && r.email) quien.textContent = r.email;
        mostrar(denegado);
        return;
      }
      abrirPanel(r);
    })
    .catch(() => {
      // Si Auth no carga (red caída, bloqueador), NO se abre el panel: fail-closed. Y se dice por qué,
      // en vez de dejar «Comprobando tu acceso…» girando para siempre.
      if (puerta) {
        puerta.innerHTML = '';
        const t = document.createElement('p');
        t.className = 'gx-gate__t';
        t.textContent = 'No pudimos comprobar tu acceso.';
        const d = document.createElement('p');
        d.className = 'gx-gate__d';
        d.textContent = 'Revisa tu conexión y recarga la página. Si usas un bloqueador, puede estar frenando el inicio de sesión.';
        puerta.appendChild(t);
        puerta.appendChild(d);
      }
    });

  // Segmentado de 3 roles: alterna las vistas [data-set] (ya renderizadas) + textos (textContent).
  // Sin innerHTML: los strings van por textContent y los bloques se muestran/ocultan con `hidden`.
  type Str = { user: string; userRole: string; avatar: string; greeting: string; subtitle: string; tableTitle: string };
  const STR: Record<string, Str> = JSON.parse(document.getElementById('gx-strings')!.textContent || '{}');
  const set = (id: string, txt: string) => { const e = document.getElementById(id); if (e) e.textContent = txt; };

  function show(role: string) {
    const s = STR[role];
    if (!s) return;
    set('gx-greeting', s.greeting);
    set('gx-subtitle', s.subtitle);
    set('gx-table-title', s.tableTitle);
    set('gx-user', s.user);
    set('gx-user-role', s.userRole);
    set('gx-avatar', s.avatar);
    document.querySelectorAll<HTMLElement>('[data-set]').forEach((el) => {
      el.hidden = el.dataset.set !== role;
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.gx-seg__btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.gx-seg__btn').forEach((b) => {
        b.classList.remove('is-on');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-on');
      btn.setAttribute('aria-selected', 'true');
      show(btn.dataset.role || 'admin');
    });
  });
</script>
