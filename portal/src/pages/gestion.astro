            <div>
              <label class="alt-label" for="a-ciudad">Ciudad</label>
              <input class="alt-input" id="a-ciudad" name="ciudad" type="text" value="Cartagena de Indias" />
              <p class="gx-hint">De la ciudad depende que se muestre la matrícula de arrendador.</p>
            </div>
            <div>
              <label class="alt-label" for="a-barrio">Barrio</label>
              <input class="alt-input" id="a-barrio" name="barrio" type="text" list="a-barrios" placeholder="Bocagrande" />
              <datalist id="a-barrios">{ZONAS.map((z) => <option value={z.nombre}></option>)}</datalist>
            </div>
            <div data-solo="alojamiento" hidden>
              <label class="alt-label" for="a-rnt">RNT</label>
              <input class="alt-input" id="a-rnt" name="rnt" type="text" placeholder="RNT-000000" />
              <p class="gx-hint">Obligatorio por ley para anunciar hospedaje.</p>
            </div>
          </div>
          <div class="gx-fgrid">
            <div><label class="alt-label" for="a-lat">Latitud</label><input class="alt-input" id="a-lat" name="lat" type="text" placeholder="10.399" /></div>
            <div><label class="alt-label" for="a-lng">Longitud</label><input class="alt-input" id="a-lng" name="lng" type="text" placeholder="-75.554" /></div>
            <div class="gx-celda-nota"><p class="gx-hint">Aproximadas, para el pin del mapa. Opcionales, y van las dos o ninguna.</p></div>
          </div>
        </section>

        <section class="gx-panel gx-pad">
          <h2>Cuánto</h2>
          <p class="gx-psub">Solo se piden los precios de la operación elegida.</p>
          <div class="gx-fgrid">
            <div data-solo="venta">
              <label class="alt-label" for="a-valorVenta">Valor de venta</label>
              <input class="alt-input" id="a-valorVenta" name="valorVenta" type="text" inputmode="numeric" placeholder="$ 450.000.000" />
            </div>
            <div data-solo="arriendo" hidden>
              <label class="alt-label" for="a-canon">Canon mensual</label>
              <input class="alt-input" id="a-canon" name="canon" type="text" inputmode="numeric" placeholder="$ 4.500.000" />
            </div>
            <div data-solo="arriendo" hidden>
              <label class="alt-label" for="a-administracion">Administración</label>
              <input class="alt-input" id="a-administracion" name="administracion" type="text" inputmode="numeric" placeholder="$ 380.000" />
              <p class="gx-hint">Aparte del canon, nunca dentro.</p>
            </div>
            <div data-solo="alojamiento" hidden>
              <label class="alt-label" for="a-precioNoche">Precio por noche</label>
              <input class="alt-input" id="a-precioNoche" name="precioNoche" type="text" inputmode="numeric" placeholder="$ 350.000" />
            </div>
          </div>
        </section>

        <section class="gx-panel gx-pad">
          <h2>Cómo es</h2>
