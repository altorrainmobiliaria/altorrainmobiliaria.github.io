        </section>

        <div class="gx-pie">
          <p class="gx-pie__msg" id="gx-alta-msg" role="status" aria-live="polite"></p>
          <button class="alt-btn alt-btn--outline" type="button" id="gx-alta-cancelar">Cancelar</button>
          <button class="alt-btn alt-btn--navy" type="submit" id="gx-alta-guardar">Guardar inmueble</button>
        </div>
      </form>
     </div>
    </main>
  </div>

  <script type="application/json" id="gx-strings" set:html={JSON.stringify(strings)}></script>
</BaseLayout>

