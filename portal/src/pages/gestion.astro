<style>
  /* ══ LISTADO DE INMUEBLES (§110) ═════════════════════════════════════════════════════════ */
  .gx-table__inner--inm .gx-tr { grid-template-columns: 2.2fr 1fr 1.4fr 1.1fr 1fr; }
  .gx-cod {
    display: block;
    font-size: 11px;
    font-weight: var(--alt-fw-semibold);
    letter-spacing: 0.04em;
    color: var(--alt-text-muted);
  }
  /* «No se ve» en ORO: en esta paleta el oro es lo que pide atención, y el rojo no existe. */
  .gx-vis__no { color: var(--alt-link); font-weight: var(--alt-fw-semibold); font-size: 13px; cursor: help; }

  /* ══ PANTALLA «NUEVO INMUEBLE» (§108) ══════════════════════════════════════════════════════
     Todo sale de `tokens.css`. Ni un color suelto: la paleta es navy / dorado / plata / blanco, y
     los estados NO usan verde ni rojo — la jerarquía se hace con oro (pide acción) y navy (reposo). */

  .gx-volver {
    background: none;
    border: 0;
    padding: 0 0 6px;
    font: inherit;
    font-size: 12.5px;
    font-weight: var(--alt-fw-semibold);
    color: var(--alt-link);
    cursor: pointer;
  }
  .gx-volver:hover { text-decoration: underline; }

  .gx-form { display: flex; flex-direction: column; gap: clamp(16px, 2vw, 22px); }
  /* El `h2` de `.gx-panel` computa margen 0 aquí, así que el subtítulo necesita separación POSITIVA.
     El `-10px` que había asumía un margen que no existe y montaba el texto encima del título. */
  .gx-psub { font-size: 12.5px; color: var(--alt-text-soft); margin: 5px 0 18px; }

  .gx-fgrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    gap: 16px;
  }
  .gx-fgrid + .gx-fgrid { margin-top: 16px; }
  .gx-fgrid--corta { grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr)); }
  .gx-frow { margin-top: 16px; }
  .gx-hint { font-size: 11.5px; color: var(--alt-text-soft); margin: 6px 0 0; line-height: 1.45; }
  /* Celda de la rejilla que solo lleva una nota: se alinea ABAJO, a la altura de los campos vecinos.
     El `align-self` tiene que ir en la CELDA (el `div`), no en el párrafo — que es lo que fallaba: el
     elemento de la rejilla es el contenedor, y el hijo no hereda su alineación. */
  .gx-celda-nota { display: flex; align-items: flex-end; }
  .gx-celda-nota .gx-hint { margin: 0 0 13px; }
  .gx-ta { font-family: inherit; resize: vertical; }

  /* Aviso de visibilidad: filo de oro, igual que el disclaimer de `/publicar`. Se lee como una nota
     honesta, no como una alarma — porque «es un borrador» no es un error. */
  .gx-aviso {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    background: var(--alt-surface);
    border: 1px solid var(--alt-hairline);
    border-left: 3px solid var(--alt-gold);
    border-radius: 14px;
    padding: 15px 18px;
    margin-bottom: 4px;
  }
  .gx-aviso__t { font-size: 13.5px; font-weight: var(--alt-fw-semibold); color: var(--alt-ink); margin: 0 0 5px; }
  .gx-aviso ul { margin: 0; padding-left: 17px; font-size: 13px; color: var(--alt-text-soft); line-height: 1.65; }

  /* Amenidades: píldora navy cuando está puesta, contorno cuando no. Mismo patrón que los chips del SERP. */
  .gx-chips { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 10px; }
  .gx-chip {
    padding: 8px 15px;
    border-radius: 999px;
    border: 1px solid var(--alt-hairline-2);
    background: var(--alt-surface);
    color: var(--alt-text-soft);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: background .2s, color .2s, border-color .2s;
  }
  .gx-chip[aria-pressed='true'] {
    background: var(--alt-surface-ink);
    border-color: var(--alt-surface-ink);
    color: #fff;
    font-weight: var(--alt-fw-medium);
  }

  /* Galería: la primera lleva el sello de PORTADA porque es la que decide la tarjeta y el enlace
     compartido — no es decoración, es la consecuencia del orden. */
  .gx-fotos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(150px, 100%), 1fr));
    gap: 14px;
    margin-bottom: 14px;
  }
  .gx-fotos:empty { display: none; }
  .gx-foto { position: relative; aspect-ratio: 4 / 3; border-radius: 13px; overflow: hidden; background: var(--alt-mist); }
  .gx-foto img { width: 100%; height: 100%; object-fit: cover; }
  .gx-foto__sello {
    position: absolute; top: 9px; left: 9px;
    padding: 4px 10px; border-radius: 999px;
    background: var(--alt-gold); color: var(--alt-surface-ink);
    font-size: 10.5px; font-weight: var(--alt-fw-bold); letter-spacing: .04em;
  }
  .gx-foto__x {
    position: absolute; top: 8px; right: 8px;
    width: 26px; height: 26px; border-radius: 50%;
    border: 0; background: rgba(6, 39, 67, .82); color: #fff;
    font-size: 15px; line-height: 1; cursor: pointer;
  }
  .gx-foto--subiendo { display: flex; align-items: center; justify-content: center; }
  .gx-foto--subiendo span { font-size: 12px; color: var(--alt-text-soft); }

  .gx-subir {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 18px; border-radius: 12px;
    border: 1px dashed var(--alt-hairline-2);
    background: var(--alt-surface);
    color: var(--alt-text-soft);
    font-size: 13.5px; cursor: pointer;
  }
  .gx-subir span { font-size: 19px; line-height: 1; color: var(--alt-link); }

  .gx-estados { display: flex; flex-direction: column; gap: 11px; }
  .gx-estado {
    display: flex; gap: 12px; align-items: flex-start;
    padding: 14px 17px; border: 1px solid var(--alt-hairline-2);
    border-radius: 13px; cursor: pointer;
  }
  .gx-estado.is-on { border-color: var(--alt-surface-ink); background: var(--alt-mist); }
  .gx-estado input { margin-top: 3px; accent-color: var(--alt-surface-ink); }
  .gx-estado b { display: block; font-size: 14px; color: var(--alt-ink); }
  .gx-estado span { font-size: 12.5px; color: var(--alt-text-soft); line-height: 1.5; }

  .gx-pie { display: flex; justify-content: flex-end; align-items: center; gap: 12px; flex-wrap: wrap; padding-bottom: 12px; }
  .gx-pie__msg { flex: 1 1 220px; margin: 0; font-size: 13px; color: var(--alt-text-soft); }
  .gx-pie__msg:empty { display: none; }

  /* Error de campo: el borde se pone dorado, no rojo (la paleta no tiene rojo), y el texto va debajo
     del campo que lo causa — no en una lista al final que obliga a buscarlo. */
  .alt-input.is-mal { border-color: var(--alt-gold); }
  .gx-err { font-size: 12px; color: var(--alt-link); margin: 5px 0 0; font-weight: var(--alt-fw-medium); }
</style>

<script>
  /*
   * PUERTA DE ACCESO del panel (§98). Ver la nota del markup: esto es UX y disuasión, no seguridad.
   * La frontera real son las Security Rules; aquí solo se decide qué se le enseña a quién.
   *
   * El orden importa: se ESPERA a que Firebase restaure la sesión antes de decidir. Leer el usuario
   * sin esperar devuelve `null` en la primera pintura aunque la persona esté dentro, y el panel la
   * echaría al login cada vez que recarga — el error clásico de esta API.
   */
  import { estadoAcceso, salir } from '../scripts/auth';
  import { montarLeads } from '../scripts/gestion-leads';
  import { montarAlta } from '../scripts/gestion-alta-ui';

  const puerta = document.getElementById('gx-gate');
  const denegado = document.getElementById('gx-denegado');
  const panel = document.getElementById('gx-panel');

  function mostrar(cual: HTMLElement | null): void {
    for (const n of [puerta, denegado, panel]) if (n) n.hidden = n !== cual;
  }

  document.getElementById('gx-salir')?.addEventListener('click', () => void salir());

  /* Volver a comprobar FORZANDO el refresco del token. Los claims viajan dentro del token y este se
     renueva cada hora, así que sin esto a quien le acaban de dar permiso le tocaba esperar o cerrar
     sesión — y lo más probable es que pensara que algo estaba roto. */
  const reintentar = document.getElementById('gx-reintentar') as HTMLButtonElement | null;
  reintentar?.addEventListener('click', async () => {
    reintentar.disabled = true;
    reintentar.textContent = 'Comprobando…';
    const r = await estadoAcceso(true).catch(() => null);
    if (r?.estado === 'staff') {
      mostrar(panel);
      void montarLeads();
      montarAlta();
      return;
    }
    reintentar.disabled = false;
    reintentar.textContent = 'Volver a comprobar';
  });

  estadoAcceso()
    .then((r) => {
      if (r.estado === 'anonimo') {
        // `volver` para que el login devuelva AQUÍ y no a favoritos: quien venía a gestionar no
        // quiere acabar en su lista de favoritos después de escribir la contraseña.
        window.location.href = '/ingresar?volver=' + encodeURIComponent('/gestion');
        return;
      }
      if (r.estado === 'sin-permiso') {
        const quien = document.getElementById('gx-quien');
        if (quien && r.email) quien.textContent = r.email;
        mostrar(denegado);
        return;
      }
      mostrar(panel);
      // Los datos REALES solo se piden cuando ya se sabe que quien mira es del equipo: pedir algo que
      // las Rules van a denegar solo ensucia la consola y confunde al siguiente que la mire.
      void montarLeads();
      montarAlta();
    })
    .catch(() => {
      // Si Auth no carga (red caída, bloqueador), NO se abre el panel: fail-closed. Y se dice por qué,
      // en vez de dejar «Comprobando tu acceso…» girando para siempre.
      if (puerta) {
        puerta.innerHTML = '';
        const t = document.createElement('p');
        t.className = 'gx-gate__t';
        t.textContent = 'No pudimos comprobar tu acceso.';
        const d = document.createElement('p');
        d.className = 'gx-gate__d';
        d.textContent = 'Revisa tu conexión y recarga la página. Si usas un bloqueador, puede estar frenando el inicio de sesión.';
        puerta.appendChild(t);
        puerta.appendChild(d);
      }
    });

  // Segmentado de 3 roles: alterna las vistas [data-set] (ya renderizadas) + textos (textContent).
  // Sin innerHTML: los strings van por textContent y los bloques se muestran/ocultan con `hidden`.
  type Str = { user: string; userRole: string; avatar: string; greeting: string; subtitle: string; tableTitle: string };
  const STR: Record<string, Str> = JSON.parse(document.getElementById('gx-strings')!.textContent || '{}');
  const set = (id: string, txt: string) => { const e = document.getElementById(id); if (e) e.textContent = txt; };

  function show(role: string) {
    const s = STR[role];
    if (!s) return;
    set('gx-greeting', s.greeting);
    set('gx-subtitle', s.subtitle);
    set('gx-table-title', s.tableTitle);
    set('gx-user', s.user);
    set('gx-user-role', s.userRole);
    set('gx-avatar', s.avatar);
    document.querySelectorAll<HTMLElement>('[data-set]').forEach((el) => {
      el.hidden = el.dataset.set !== role;
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.gx-seg__btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.gx-seg__btn').forEach((b) => {
        b.classList.remove('is-on');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-on');
      btn.setAttribute('aria-selected', 'true');
      show(btn.dataset.role || 'admin');
    });
  });
</script>
