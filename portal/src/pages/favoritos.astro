---
/*
 * FAVORITOS (/favoritos) — réplica de `ALTORRA Ingresar-Favoritos.dc.html`, artboards 2a/2b/2c.
 * El header ya enlazaba aquí y daba 404 desde que existe el portal (§89).
 *
 * Se pinta ENTERA en el cliente desde `localStorage` (módulo `scripts/favoritos.ts`): no hay datos
 * en el servidor que renderizar, y así funciona igual con el catálogo en demo o en vivo.
 * Los 3 estados del mockup salen de un mismo DOM: lista · vacío · invitación a sincronizar.
 *
 * Las cards se construyen clonando el `<template id="tpl-pcard">` con el PropertyCard REAL —mismo
 * patrón que la isla del SERP (§59)—: el markup de la card tiene UN dueño y no puede divergir (L-29),
 * y se rellena con `textContent`, nunca con innerHTML.
 */
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PropertyCard from '../components/PropertyCard.astro';

const heart =
  '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>';
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---

<BaseLayout title="Tus favoritos — ALTORRA Inmobiliaria" description="Los inmuebles que guardaste en ALTORRA Inmobiliaria.">
  <Header />

  <main id="main" class="fav">
    <div class="alt-container">
      <header class="fav__head">
        <div>
          <p class="alt-eyebrow">Tu selección</p>
          <h1 class="fav__h">Favoritos</h1>
          <p class="fav__count" id="fav-count">Cargando…</p>
        </div>
        <a class="alt-btn alt-btn--outline" href="/comprar">
          Ver catálogo<span class="alt-btn__arw"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={arrow}></svg></span>
        </a>
      </header>

      {/* Estado CON guardados */}
      <section id="fav-lista" hidden>
        <div class="fav__grid" id="fav-grid"></div>

        {/* El artboard "Sin sesión" del mockup: con los favoritos en el navegador, la invitación a
            ingresar no es una puerta sino un recordatorio de que se pueden sincronizar. */}
        <aside class="fav__sync alt-card alt-card--neu">
          <div>
            <p class="fav__sync-h">Ingresa para no perder lo que guardaste</p>
            <p class="fav__sync-p">Hoy tus favoritos viven en este navegador. Si entras a tu cuenta, te siguen a cualquier dispositivo.</p>
          </div>
          <a class="alt-btn alt-btn--navy" href="/ingresar">Ingresar</a>
        </aside>
      </section>

      {/* Estado VACÍO */}
      <section class="fav__empty" id="fav-vacio" hidden>
        <span class="fav__empty-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={heart}></svg>
        </span>
        <h2 class="fav__empty-h">Aún no has guardado ningún inmueble</h2>
        <p class="fav__empty-p">Toca el corazón en cualquier propiedad y la encontrarás aquí.</p>
        <div class="fav__empty-cta">
          <a class="alt-btn alt-btn--gold" href="/comprar">Explorar catálogo</a>
          <a class="alt-btn alt-btn--outline" href="/arrendar">Ver arriendos</a>
        </div>
      </section>

      {/* Molde de la card: el PropertyCard REAL con todas sus partes opcionales presentes; el script
          borra las que no apliquen. No se muestra ni se indexa (<template>). */}
      <template id="tpl-pcard">
        <PropertyCard
          img="" alt="" badge="En venta" zona="" beds={0} baths={0} area="0 m²"
          title="" price="" priceLabel="Desde" priceSuffix="/mes" href="#"
        />
      </template>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .fav { background: var(--alt-surface-neu); padding-block: clamp(40px, 6vw, 72px) clamp(56px, 8vw, 96px); min-height: 60vh; }

  .fav__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--alt-space-5); flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 44px); }
  .fav__h { font-family: var(--alt-font-display); font-size: var(--alt-fs-h1); color: var(--alt-ink); margin: var(--alt-space-2) 0 0; }
  .fav__count { margin: var(--alt-space-2) 0 0; color: var(--alt-text-soft); font-size: var(--alt-fs-sm); }

  .fav__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(292px, 1fr)); gap: clamp(20px, 2.5vw, 30px); }

  .fav__sync { display: flex; align-items: center; justify-content: space-between; gap: var(--alt-space-5); flex-wrap: wrap; margin-top: clamp(32px, 4vw, 48px); padding: var(--alt-space-5) var(--alt-space-6); }
  .fav__sync-h { margin: 0; font-weight: 600; color: var(--alt-ink); }
  .fav__sync-p { margin: 6px 0 0; font-size: var(--alt-fs-sm); color: var(--alt-text-soft); max-width: 52ch; }

  .fav__empty { text-align: center; max-width: 560px; margin-inline: auto; padding-block: clamp(40px, 8vw, 88px); }
  .fav__empty-ico { display: grid; place-items: center; width: 84px; height: 84px; margin-inline: auto; border-radius: 50%; background: var(--alt-surface); color: var(--alt-gold); box-shadow: var(--alt-nm-up); }
  .fav__empty-ico svg { width: 38px; height: 38px; }
  .fav__empty-h { font-family: var(--alt-font-display); font-size: var(--alt-fs-h2); color: var(--alt-ink); margin: var(--alt-space-5) 0 0; }
  .fav__empty-p { margin: var(--alt-space-3) 0 0; color: var(--alt-text-soft); }
  .fav__empty-cta { display: flex; gap: var(--alt-space-3); justify-content: center; flex-wrap: wrap; margin-top: var(--alt-space-6); }

  @media (max-width: 640px) {
    .fav__head { align-items: flex-start; }
    .fav__sync { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  import { listar, quitar, EVENTO, type FavoritoGuardado } from '../scripts/favoritos';

  const grid = document.getElementById('fav-grid');
  const secLista = document.getElementById('fav-lista');
  const secVacio = document.getElementById('fav-vacio');
  const cuenta = document.getElementById('fav-count');
  const tpl = document.querySelector<HTMLTemplateElement>('#tpl-pcard');

  /** Igual que la isla del SERP: `null` borra el nodo, un string lo rellena como TEXTO. */
  function texto(root: ParentNode, sel: string, valor: string | null): void {
    const el = root.querySelector<HTMLElement>(sel);
    if (!el) return;
    if (valor === null) el.remove();
    else el.textContent = valor;
  }

  function construirCard(f: FavoritoGuardado): DocumentFragment | null {
    if (!tpl) return null;
    const frag = tpl.content.cloneNode(true) as DocumentFragment;
    const card = frag.querySelector<HTMLElement>('.alt-pcard');
    if (!card) return null;
    card.dataset.favId = f.id;

    const img = frag.querySelector<HTMLImageElement>('.alt-pcard__media img');
    if (img) {
      if (f.img) { img.src = f.img; img.alt = f.alt; } else { img.remove(); }
    }

    texto(frag, '.alt-pcard__badge', f.badge || null);
    texto(frag, '.alt-pcard__zona', f.zona);

    // El molde ya trae los 3 spans con su icono correcto: se conserva el que corresponde a cada
    // spec guardada y se BORRAN los que no vienen. Asi el icono nunca se separa de su dato.
    const specs = frag.querySelector('.alt-pcard__specs');
    if (specs) {
      const porTipo = new Map(f.specs.map((s) => [s.tipo, s.valor]));
      const spans = [...specs.querySelectorAll<HTMLElement>('span')];
      for (const span of spans) {
        const v = porTipo.get(span.dataset.spec || '');
        if (v == null) { span.remove(); continue; }
        // Se cambia SOLO el nodo de texto: el <svg> del icono se queda donde esta.
        for (const n of [...span.childNodes]) if (n.nodeType === Node.TEXT_NODE) n.remove();
        span.appendChild(document.createTextNode(v));
      }
      if (!specs.querySelector('span')) specs.remove();
    }

    const enlaceTitulo = frag.querySelector<HTMLAnchorElement>('.alt-pcard__title a');
    if (enlaceTitulo) { enlaceTitulo.textContent = f.titulo; enlaceTitulo.href = f.href; }

    texto(frag, '.alt-pcard__price-lbl', f.precioLabel || null);
    texto(frag, '.alt-pcard__price-sfx', f.precioSufijo || null);
    // El importe es el nodo de texto suelto dentro de `.alt-pcard__price`, entre etiqueta y sufijo.
    const precio = frag.querySelector('.alt-pcard__price');
    if (precio) {
      for (const n of [...precio.childNodes]) if (n.nodeType === Node.TEXT_NODE) n.remove();
      const lbl = precio.querySelector('.alt-pcard__price-lbl');
      const nodo = document.createTextNode(f.precio);
      if (lbl && lbl.nextSibling) precio.insertBefore(nodo, lbl.nextSibling);
      else if (lbl) precio.appendChild(nodo);
      else precio.insertBefore(nodo, precio.firstChild);
    }

    const orbe = frag.querySelector<HTMLAnchorElement>('.alt-pcard__orb');
    if (orbe) { orbe.href = f.href; orbe.setAttribute('aria-label', `Ver ${f.titulo}`); }

    // Aquí el corazón nace LLENO y su trabajo es quitar, no guardar.
    const fav = frag.querySelector<HTMLButtonElement>('.alt-pcard__fav');
    if (fav) {
      fav.setAttribute('aria-pressed', 'true');
      fav.setAttribute('aria-label', `Quitar ${f.titulo} de favoritos`);
      fav.dataset.favCableado = '1'; // que el cableado global no lo vuelva a tomar
      fav.querySelector('svg')?.setAttribute('fill', 'currentColor');
    }
    return frag;
  }

  function pintar(): void {
    if (!grid || !secLista || !secVacio || !cuenta) return;
    const favs = listar();
    const n = favs.length;
    cuenta.textContent = n === 0 ? 'Nada guardado todavía' : `${n} ${n === 1 ? 'inmueble guardado' : 'inmuebles guardados'}`;
    secLista.hidden = n === 0;
    secVacio.hidden = n !== 0;
    grid.textContent = '';
    for (const f of favs) {
      const frag = construirCard(f);
      if (frag) grid.appendChild(frag);
    }
  }

  // Delegación: el grid se re-pinta entero, así que escuchar en él evita re-cablear en cada pintada.
  grid?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.alt-pcard__fav');
    if (!btn) return;
    e.preventDefault();
    const id = btn.closest<HTMLElement>('.alt-pcard')?.dataset.favId;
    if (id) quitar(id);
  });

  document.addEventListener(EVENTO, pintar);
  pintar();
</script>
