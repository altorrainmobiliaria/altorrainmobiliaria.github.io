---
/*
 * ESTANCIAS — corta estancia (Ola 1). Esqueleto de ALTORRA Estancias.dc.html: cabecera
 * `.est-top/.est-head` y cuerpo a dos columnas `.est-body`, con las tarjetas REALES del shard `dias`
 * en la columna principal y, en el aside, la SOLICITUD de fechas, sin precio.
 *
 * ⛔ Aquí vivía una casa FICTICIA: galería, «Lo que ofrece», aforo de 8 y $850.000 la noche con su
 * desglose, sobre un alojamiento que no existe. El aviso de «ejemplo» no lo arreglaba: un precio por
 * noche es publicidad de hospedaje, y la Ley 300/1996 le exige un RNT que esa casa no podía tener.
 * El diseño completo del mockup (galería, servicios, panel con precio) va a la ficha de CADA
 * alojamiento, que sí tiene su número. `verify:build` pone en rojo cualquier importe con «$» que
 * vuelva a este HTML, en todos los modos.
 *
 * Hoy es una solicitud, no una reserva: el pago protegido (Wompi custodia) es Ola 2.
 */
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StayCard from '../components/StayCard.astro';
import { LEGAL, TEXTO_AUTORIZACION, RUTA_AVISO } from '../lib/config/legal';
import { SITE } from '../lib/config/site';
import { FUENTE, TEXTO_SIN_ALOJAMIENTOS } from '../scripts/catalogo-card';

/*
 * El interruptor de la portada (§276), leído de su dueño (`FUENTE`): con catálogo real el HTML dice
 * «Cargando…» y la isla pinta lo que haya; en demo NO hay tarjetas de muestra, el HTML trae
 * directamente el vacío honesto.
 */
const HAY_CATALOGO_REAL = FUENTE === 'live';

// Sin `description` propia, A PROPÓSITO: comparte la del sitio hasta que el RNT de la plataforma esté
// verificado. El motivo vive en `COMPARTIDA_OK` de `scripts/verify-seo.mjs`.
---

<BaseLayout
  title="Corta estancia en Cartagena — ALTORRA"
  miga={[{ nombre: 'Corta estancia', ruta: '/estancias' }]}
>
  <Header active="estancia" />

  <main id="main">
    {/* Textos aprobados de la sección #estancias-list del mockup del Portal. */}
    <div class="est-top">
      <div class="est-head">
        <p class="alt-eyebrow">Corta estancia</p>
        <h1 class="est-h1">Quédate unos días.</h1>
      </div>
    </div>

    <div class="est-body">
      <div class="est-main-col">
        {/* `aria-live` + `aria-busy`: quien usa lector de pantalla oye el resultado (las tarjetas, el
            vacío o el error) cuando la isla termina, no solo «Cargando…». */}
        <div class="est-cards" data-estancias-set aria-live="polite" aria-busy={HAY_CATALOGO_REAL ? 'true' : undefined}>
          {HAY_CATALOGO_REAL
            ? <p class="est-vacio">Cargando alojamientos…</p>
            : <p class="est-vacio">{TEXTO_SIN_ALOJAMIENTOS}</p>}
        </div>
        <noscript>
          <p class="est-vacio">Sin JavaScript esta página no puede cargar los alojamientos ni enviar tu solicitud.
            Escríbenos por <a href={SITE.contact.whatsappLink} rel="noopener">WhatsApp</a> y te contamos qué tenemos para tus fechas.</p>
        </noscript>

        {/* La tarjeta la pinta la isla clonando ESTA plantilla, la misma `StayCard` de la portada.
            `rnt=""` emite su hueco del RNT: sin él `pintarStay` no pinta, y un precio por noche no
            sale sin su número. `favorito={false}` quita el corazón: aquí nadie lo escucha, y un botón
            que dice «Guardar en favoritos» y abre la ficha promete lo que no hace. */}
        <template id="tpl-estancias-staycard">
          <StayCard img="" alt="" title="" meta="" price="" priceUnit="COP noche" href="#" rnt="" favorito={false} />
        </template>
      </div>

      {/* Solicitud de fechas, en modo CONSULTA: no hay alojamiento elegido, así que no hay precio que
          enseñar. El envío a /api/solicitud (formulario `reserva-estancia`) es el de siempre. */}
      <aside class="est-aside" id="reservar">
        <div class="est-book">
          <h2 class="est-book__h">Cuéntanos tus fechas</h2>
          <div class="est-book__box">
            <div class="est-book__dates">
              <label><span>Llegada</span><input type="date" id="est-ci" /></label>
              <label><span>Salida</span><input type="date" id="est-co" /></label>
            </div>
            <div class="est-book__guests">
              <div><span class="est-book__glbl">Huéspedes</span><span id="est-guests-label">2 huéspedes</span></div>
              <div class="est-book__stepper">
                <button type="button" id="est-dec" aria-label="Menos huéspedes">−</button>
                <span id="est-guests">2</span>
                <button type="button" id="est-inc" aria-label="Más huéspedes">+</button>
              </div>
            </div>
          </div>
          <button class="alt-btn alt-btn--navy est-book__cta" id="est-reservar" type="button">Solicitar estas fechas<span class="alt-btn__arw"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></button>
          <p class="est-book__note">No es una reserva ni se cobra nada: te confirmamos disponibilidad por WhatsApp.</p>

          {/* Paso de contacto. Aparece al pedir las fechas: pedir nombre y teléfono ANTES de que
               nadie haya elegido nada es la forma más rápida de que se vayan. */}
          <form class="est-datos" id="est-datos" hidden novalidate>
            <label class="est-f"><span>Tu nombre</span><input class="alt-input" type="text" id="est-nombre" name="nombre" autocomplete="name" required /></label>
            <label class="est-f"><span>WhatsApp</span><input class="alt-input" type="tel" id="est-tel" name="telefono" autocomplete="tel" placeholder="300 123 4567" required /></label>
            <label class="est-check">
              <input type="checkbox" id="est-auth" name="autorizacion" value="on" required />
              <span>
                {TEXTO_AUTORIZACION.p1}<a href={RUTA_AVISO} target="_blank" rel="noopener">{TEXTO_AUTORIZACION.linkAviso}</a>{TEXTO_AUTORIZACION.p2}<a href={LEGAL.politicaDatos.ruta} target="_blank" rel="noopener">{TEXTO_AUTORIZACION.linkPolitica}</a>{TEXTO_AUTORIZACION.p3}
              </span>
            </label>
            <button class="alt-btn alt-btn--navy est-book__cta" type="submit" id="est-enviar">Enviar solicitud</button>
          </form>
          {/* El error vive FUERA del formulario: también avisa de unas fechas no válidas, y entonces el
              formulario sigue `hidden` — dentro de él, el aviso ni se veía ni se anunciaba. */}
          <p class="est-err" id="est-err" role="alert" hidden></p>
          <div class="alt-alert alt-alert--success est-confirm" id="est-confirm" role="status" tabindex="-1" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            <span>Recibimos tu solicitud. Te escribimos por WhatsApp para confirmar disponibilidad: <b>todavía no es una reserva</b>.</span>
          </div>
        </div>
        <p class="est-cancel">Te proponemos lo que tengamos disponible para esas fechas.</p>
      </aside>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .est-top { max-width: 1300px; margin-inline: auto; padding: 26px clamp(16px, 4vw, 48px) 0; }
  .est-h1 { margin-top: var(--alt-space-2); font-size: clamp(30px, 4.4vw, 48px); line-height: 1.02; }

  .est-body { max-width: 1300px; margin-inline: auto; padding: 34px clamp(16px, 4vw, 48px) 64px; display: flex; gap: clamp(28px, 3.4vw, 56px); flex-wrap: wrap; align-items: flex-start; }
  .est-main-col { flex: 1 1 540px; min-width: 300px; }
  /* Las StayCard son de ancho FIJO: la rejilla solo las deja fluir y saltar de línea. */
  .est-cards { display: flex; flex-wrap: wrap; gap: var(--alt-space-7) var(--alt-gap-grid); }
  /* :global porque el párrafo de vacío o de error lo crea la ISLA y no lleva el atributo con el que
     Astro acota sus reglas (verify:css). Es el mismo estilo que `.home-vacio` de la portada. */
  :global(.est-vacio) { max-width: 62ch; margin: 0; font-size: 15.5px; line-height: 1.65; color: var(--alt-text); }

  /* Panel de solicitud */
  .est-aside { flex: 1 1 340px; min-width: 300px; position: sticky; top: 92px; align-self: flex-start; }
  .est-book { background: var(--alt-white); border: 1px solid var(--alt-hairline-2); border-radius: var(--alt-r-lg); padding: 24px; box-shadow: var(--alt-elev-booking, 0 34px 64px -40px rgba(27, 39, 51, 0.45)); }
  /* En el hueco del precio del mockup: aquí no hay alojamiento elegido, así que no hay precio. */
  .est-book__h { margin: 0 0 var(--alt-space-5); font-family: var(--alt-font-display); font-weight: var(--alt-fw-semibold); font-size: var(--alt-fs-h3); line-height: 1.1; letter-spacing: normal; color: var(--alt-ink); }
  .est-book__box { border: 1px solid var(--alt-hairline-2); border-radius: var(--alt-r-frame, 14px); overflow: hidden; margin-bottom: 16px; }
  .est-book__dates { display: grid; grid-template-columns: 1fr 1fr; }
  /*
   * 🔴 `min-width: 0` NO es cosmético (§264). Una celda de grid se niega por defecto a encoger por
   * debajo del ancho intrínseco de su contenido, así que estas dos columnas `1fr 1fr` sumaban 315 px
   * dentro de una caja de 291: medido a 375 px, el campo «Salida» **sobresalía 24 px** y la caja lo
   * recortaba con su `overflow: hidden`.
   */
  .est-book__dates label { padding: 12px 14px; border-bottom: 1px solid var(--alt-hairline); cursor: pointer; min-width: 0; }
  .est-book__dates label:first-child { border-right: 1px solid var(--alt-hairline); }
  .est-book__dates span, .est-book__glbl { display: block; font-size: 10px; font-weight: var(--alt-fw-bold); letter-spacing: 0.1em; text-transform: uppercase; color: var(--alt-text); margin-bottom: 3px; }
  .est-book__dates input { border: none; outline: none; font-size: 14px; font-weight: var(--alt-fw-semibold); color: var(--alt-ink); width: 100%; background: transparent; padding: 0; font-family: var(--alt-font-body); }
  /*
   * Las fechas a 16 px en movil, por el zoom de iOS (§264). La regla general vive en
   * `components.css`, pero estos dos campos los estila ESTE fichero, y el acotado que Astro le pone
   * gana en especificidad: la override tiene que estar junto a la regla que debe vencer.
   */
  @media (max-width: 900px) {
    .est-book__dates input { font-size: var(--alt-fs-body); }
  }
  .est-book__guests { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; }
  .est-book__guests > div:first-child span:last-child { font-size: 14px; font-weight: var(--alt-fw-semibold); color: var(--alt-ink); }
  .est-book__stepper { display: flex; align-items: center; gap: 12px; }
  .est-book__stepper button { width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--alt-hairline-strong); background: var(--alt-white); color: var(--alt-ink); font-size: 18px; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: border-color var(--alt-dur) var(--alt-ease), color var(--alt-dur) var(--alt-ease); }
  .est-book__stepper button:hover { border-color: var(--alt-gold); color: var(--alt-link); }
  .est-book__stepper > span { font-size: 15px; font-weight: var(--alt-fw-semibold); color: var(--alt-ink); min-width: 16px; text-align: center; }
  .est-book__cta { width: 100%; }
  .est-book__note { text-align: center; font-size: 12px; color: var(--alt-text); margin-top: 12px; }
  /* Paso de contacto (§122): aparece bajo el CTA cuando las fechas ya son válidas. */
  .est-datos { display: grid; gap: 12px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--alt-hairline); }
  .est-f { display: grid; gap: 5px; font-size: 12.5px; color: var(--alt-text); }
  .est-check { display: flex; gap: 9px; align-items: flex-start; font-size: 11.5px; line-height: 1.45; color: var(--alt-text-muted); }
  .est-check input { margin-top: 2px; flex: 0 0 auto; }
  .est-check a { color: var(--alt-navy); }
  /* El error va en dorado: la paleta no tiene rojo (identidad de marca). */
  .est-err { margin-top: var(--alt-space-3); font-size: 12.5px; line-height: 1.4; color: var(--alt-ink); background: var(--alt-mist); border-left: 3px solid var(--alt-gold); padding: 9px 11px; border-radius: 8px; }
  .est-confirm { margin-top: 16px; }
  .est-cancel { text-align: center; font-size: 12px; color: var(--alt-text); margin-top: 14px; }
</style>

<script>
  import { bootEstanciasCatalogo } from '../scripts/estancias-catalogo';
  import { explicarProblemaReserva, HUESPEDES_MAX, problemasDeReserva } from '../lib/domain/reserva';

  // Los alojamientos reales (shard `dias`). La isla atrapa sus propios fallos y deja el texto de
  // error; este `catch` es solo la red por si algo escapara.
  bootEstanciasCatalogo().catch(() => {
    /* nunca relleno: lo peor que queda es el estado que ya trae el HTML */
  });

  /** Un día en `YYYY-MM-DD` LOCAL: el visitante elige fechas en su calendario, no en UTC. */
  const iso = (d: Date) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  const $ = (id: string) => document.getElementById(id);
  let guests = 2;

  // El tope es el del DOMINIO, el mismo que impone el endpoint: si el panel dejara pedir más, el
  // visitante se enteraría con un 422 después de escribir sus datos.
  function setGuests(g: number) {
    guests = Math.max(1, Math.min(HUESPEDES_MAX, g));
    if ($('est-guests')) $('est-guests')!.textContent = String(guests);
    if ($('est-guests-label')) $('est-guests-label')!.textContent = guests === 1 ? '1 huésped' : `${guests} huéspedes`;
  }
  $('est-dec')?.addEventListener('click', () => setGuests(guests - 1));
  $('est-inc')?.addEventListener('click', () => setGuests(guests + 1));

  // ── SOLICITUD REAL (§122) ──────────────────────────────────────────────────────────────────
  // Antes esto era `removeAttribute('hidden')` sobre el mensaje de éxito: el visitante leía
  // «Solicitud enviada» y no se enviaba NADA. Un fallo silencioso que además mentía.
  const err = (txt: string) => {
    const e = $('est-err');
    if (!e) return;
    e.textContent = txt;
    e.removeAttribute('hidden');
  };

  $('est-reservar')?.addEventListener('click', () => {
    const ci = ($('est-ci') as HTMLInputElement | null)?.value ?? '';
    const co = ($('est-co') as HTMLInputElement | null)?.value ?? '';
    const malos = problemasDeReserva({ llegada: ci, salida: co, huespedes: guests }, iso(new Date()));
    if (malos.length) { err(malos.map(explicarProblemaReserva).join(' ')); return; }
    $('est-err')?.setAttribute('hidden', '');
    $('est-datos')?.removeAttribute('hidden');
    ($('est-nombre') as HTMLInputElement | null)?.focus();
  });

  $('est-datos')?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const btn = $('est-enviar') as HTMLButtonElement | null;
    const nombre = (($('est-nombre') as HTMLInputElement | null)?.value ?? '').trim();
    const telefono = (($('est-tel') as HTMLInputElement | null)?.value ?? '').trim();
    const autoriza = ($('est-auth') as HTMLInputElement | null)?.checked;

    if (nombre.length < 2) { err('Dinos cómo te llamas.'); return; }
    if (telefono.length < 7) { err('Necesitamos un WhatsApp para confirmarte.'); return; }
    // El servidor ya lo rechaza (422), pero avisar aquí evita que pierda lo escrito. NUNCA se
    // premarca ni se marca por él: el silencio no es autorización (Ley 1581 art. 9).
    if (!autoriza) { err('Marca la autorización de datos para poder responderte.'); return; }
    $('est-err')?.setAttribute('hidden', '');

    if (btn) { btn.disabled = true; btn.textContent = 'Enviando…'; }
    try {
      const res = await fetch('/api/solicitud', {
        method: 'POST',
        headers: { 'content-type': 'application/json', accept: 'application/json' },
        body: JSON.stringify({
          formulario: 'reserva-estancia',
          nombre,
          telefono,
          autorizacion: 'on',
          llegada: ($('est-ci') as HTMLInputElement | null)?.value ?? '',
          salida: ($('est-co') as HTMLInputElement | null)?.value ?? '',
          huespedes: guests,
        }),
      });
      const cuerpo = (await res.json().catch(() => null)) as { ok?: boolean; mensajes?: string[] } | null;
      if (!res.ok || !cuerpo?.ok) {
        err(cuerpo?.mensajes?.join(' ') || 'No pudimos enviar la solicitud. Intenta de nuevo o escríbenos por WhatsApp.');
        if (btn) { btn.disabled = false; btn.textContent = 'Enviar solicitud'; }
        return;
      }
      $('est-datos')?.setAttribute('hidden', '');
      $('est-confirm')?.removeAttribute('hidden');
      // El foco estaba en el botón que se acaba de ocultar: sin esto se pierde y el lector de
      // pantalla no llega a la confirmación.
      $('est-confirm')?.focus();
    } catch {
      err('No pudimos conectar. Revisa tu conexión o escríbenos por WhatsApp.');
      if (btn) { btn.disabled = false; btn.textContent = 'Enviar solicitud'; }
    }
  });

  // Fechas prellenadas (llegada hoy+7, salida hoy+10) y con mínimo, para que no se puedan elegir
  // días pasados.
  const now = new Date();
  const ciEl = $('est-ci') as HTMLInputElement | null;
  const coEl = $('est-co') as HTMLInputElement | null;
  if (ciEl) { ciEl.value = iso(new Date(now.getTime() + 7 * 864e5)); ciEl.min = iso(now); }
  if (coEl) { coEl.value = iso(new Date(now.getTime() + 10 * 864e5)); coEl.min = iso(new Date(now.getTime() + 864e5)); }
</script>
