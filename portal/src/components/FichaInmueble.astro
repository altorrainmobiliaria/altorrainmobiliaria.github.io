---
/*
 * FICHA DE INMUEBLE — el CUERPO de la página, con UN solo dueño del markup.
 *
 * POR QUÉ ES UN COMPONENTE Y NO UNA PÁGINA: dos rutas lo pintan (`/inmueble/[slug]`, la canónica, y
 * `/ficha`, que sostiene el andamio demo mientras el catálogo no sea real). Si cada ruta tuviera su
 * copia del markup, divergirían sin que nada fallara — que es exactamente cómo este proyecto se quemó
 * con las cards del SERP (L-29). El diseño sellado (§26/§43) vive aquí y en ningún otro sitio.
 *
 * LA REGLA QUE GOBIERNA CADA BLOQUE (§60.3 → §97): **un bloque sin dato se OMITE**. Por eso hay tantos
 * condicionales: la maqueta pintaba 6 specs, 8 amenidades y 6 puntos de interés SIEMPRE, y en una
 * propiedad real eso obligaría a inventar. Aquí una propiedad con 3 specs muestra 3.
 *
 * LO QUE NO SE PINTA NUNCA, y por qué (el contenido real de este archivo):
 *  · **Dirección exacta** — está PROHIBIDA en el documento público: es PII y riesgo de seguridad, y
 *    vive en `captaciones`. Se muestra barrio y ciudad.
 *  · **Financiación** («Desde $7.9M/mes») — no está modelada y es una afirmación financiera sobre un
 *    crédito. Ese carril es legal, no de maquetación.
 *  · **Asesor con nombre y foto** — no existe en el modelo. Va el equipo con el WhatsApp REAL del
 *    negocio: inventar «María Restrepo» sería inventar una persona.
 *  · **Puntos de interés con minutos** — necesitan una fuente de tiempos de viaje (costo recurrente).
 *    Su columna la ocupa ahora algo que SÍ es verdad: la zona, enlazada a su landing.
 */
import { SITE } from '../lib/config/site';
import { urlMedia } from '../lib/media';
import PropertyCard from './PropertyCard.astro';
import type { Propiedad } from '../lib/domain/propiedades';
import type { CatalogoResumen } from '../lib/domain/catalogo';
import { ZONAS } from '../lib/content/zonas';
import {
  amenidadesVisibles,
  avisoEstado,
  etiquetaBadge,
  exhibeMatricula,
  fichaTecnica,
  frescuraTexto,
  historialPrecio,
  jsonLdInmueble,
  mensajeWhatsApp,
  migas,
  precioFicha,
  rutaOperacion,
  rutaFicha,
  specsVisibles,
  sufijoPrecio,
  ubicacionPublica,
} from '../lib/domain/ficha';

interface Props {
  p: Propiedad;
  similares?: CatalogoResumen[];
  /** URL absoluta canónica, para el JSON-LD. La calcula la ruta, que es quien conoce el host. */
  canonical: string;
}

const { p, similares = [], canonical } = Astro.props;

const imagenes = (p.imagenes ?? []).map(urlMedia).filter(Boolean);
const portada = urlMedia(p.imagenPortada ?? '') || imagenes[0] || '';
// La galería no repite la portada: el demo pintaba la misma foto dos veces porque tenía 4 y le sobraba.
const secundarias = imagenes.filter((src) => src !== portada);
const totalFotos = new Set([portada, ...imagenes].filter(Boolean)).size;

const specs = specsVisibles(p);
const tecnica = fichaTecnica(p);
const amenidades = amenidadesVisibles(p);
const historial = historialPrecio(p);
const precio = precioFicha(p);
const frescura = frescuraTexto(p);
// Enlace a la landing de la zona (§92) cuando el barrio coincide con una de las 13. Es enlazado
// interno REAL: la landing existe, describe el barrio y responde la intención «cómo se vive aquí».
const zona = ZONAS.find((z) => z.nombre.toLowerCase() === (p.geo?.barrio ?? '').toLowerCase());

const bc = migas(p, zona?.slug);
const ubicacion = ubicacionPublica(p);
const aviso = avisoEstado(p);

const tieneMapa = p.geo?.lat != null && p.geo?.lng != null;
const marcadores = tieneMapa ? [{ i: 0, lat: p.geo.lat, lng: p.geo.lng, label: p.geo.barrio || 'Cartagena' }] : [];

const waVisita = encodeURIComponent(mensajeWhatsApp(p, 'visita'));
const waInfo = encodeURIComponent(mensajeWhatsApp(p, 'info'));

const jsonLdProp = jsonLdInmueble(p, canonical, imagenes);
const jsonLdBc = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: bc.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.nombre,
    ...(m.href ? { item: new URL(m.href, canonical).href } : {}),
  })),
};

// Iconos de las specs. La plantilla es dueña del SVG; el dominio solo dice CUÁL va (`icono`).
const ICONO: Record<string, string> = {
  hab: '<path d="M2 4v16"/><path d="M2 9h16a3 3 0 0 1 3 3v8"/><path d="M2 15h20"/><path d="M6 9V7a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v2"/>',
  bano: '<path d="M5 12V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2"/><path d="M4 12h16a1 1 0 0 1 1 1v2a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4v-2a1 1 0 0 1 1-1z"/><path d="M7 19l-1 2M18 19l1 2"/>',
  area: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/>',
  parqueadero: '<path d="M5 13l1.6-4.8A2 2 0 0 1 8.5 7h7a2 2 0 0 1 1.9 1.2L19 13"/><path d="M4 13h16a1 1 0 0 1 1 1v4H3v-4a1 1 0 0 1 1-1z"/><circle cx="7.5" cy="18" r="1.4"/><circle cx="16.5" cy="18" r="1.4"/>',
  estrato: '<path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 12l10 5 10-5"/><path d="M2 17l10 5 10-5"/>',
  anio: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/>',
  piso: '<path d="M3 21h18M6 21V8l6-4 6 4v13"/><path d="M10 21v-6h4v6"/>',
};
const ICO_CHECK = '<path d="M20 6 9 17l-5-5"/>';
const ICO_WA =
  '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>';
---

<main id="main">
  <nav class="ficha-bc" aria-label="Ruta de navegación">
    {bc.map((m, i) => (
      <>
        {m.href ? <a href={m.href}>{m.nombre}</a> : <span class="ficha-bc__cur">{m.nombre}</span>}
        {i < bc.length - 1 && <span>/</span>}
      </>
    ))}
  </nav>

  {/* Galería. Sin fotos NO se pinta el bloque: un marco vacío se lee como error de la página. */}
  {portada && (
    <div class="ficha-gal-wrap">
      <div class={`ficha-gal${secundarias.length === 0 ? ' ficha-gal--sola' : ''}`}>
        <div class="ficha-gal__main">
          <img id="ficha-main" src={portada} alt={p.titulo} fetchpriority="high" />
          {/* El badge sigue al ESTADO, no solo a la operación: sobre un inmueble ya vendido, un sello
              «En venta» encima de la foto contradice al aviso que está tres centímetros más abajo. */}
          <span class="alt-badge ficha-gal__badge">{aviso ? aviso.titulo : etiquetaBadge(p.operacion)}</span>
        </div>
        {secundarias.slice(0, 2).map((src, i) => (
          <div class="ficha-gal__cell">
            <img src={src} alt={`${p.titulo} — foto ${i + 2}`} loading="lazy" decoding="async" />
            {i === 1 && totalFotos > 3 && (
              <a class="ficha-gal__more" href="#galeria">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                Ver {totalFotos} fotos
              </a>
            )}
          </div>
        ))}
      </div>
      {/* Miniaturas solo si hay más de una foto: una sola miniatura no es una galería. */}
      {imagenes.length > 1 && (
        <div id="galeria" class="ficha-thumbs">
          {[portada, ...secundarias].map((g, i) => (
            <button class={`ficha-thumb${i === 0 ? ' is-on' : ''}`} type="button" data-src={g}>
              <img src={g} alt={`Foto ${i + 1}`} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      )}
    </div>
  )}

  <div class="ficha-body">
    <div class="ficha-main-col">
      <div class="ficha-title">
        <div>
          <p class="alt-eyebrow">{p.geo?.barrio || p.geo?.ciudad}</p>
          <h1 class="ficha-h1">{p.titulo}</h1>
          {/* Barrio y ciudad. La dirección exacta NO se publica: es PII y vive en `captaciones`. */}
          <p class="ficha-addr">{ubicacion}</p>
        </div>
        <div class="ficha-actions">
          <button class="ficha-iconbtn ficha-fav" type="button" aria-label="Guardar en favoritos" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></button>
          <button class="ficha-iconbtn ficha-share" type="button" aria-label="Compartir"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg></button>
        </div>
      </div>

      {specs.length > 0 && (
        <div class="ficha-specs">
          {specs.map((s) => (
            <div class="ficha-spec">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICONO[s.icono] ?? ICONO.hab}></svg>
              <span class="ficha-spec__v">{s.valor}</span>
              <span class="ficha-spec__l">{s.etiqueta}</span>
            </div>
          ))}
        </div>
      )}

      {p.descripcion && (
        <div class="ficha-sec ficha-sec--first">
          <h2>Sobre esta propiedad</h2>
          {p.descripcion.split(/\n{2,}/).map((par) => <p>{par.trim()}</p>)}
        </div>
      )}
    </div>

    <aside class="ficha-aside">
      <div class="ficha-price">
        {aviso && (
          /* Las Rules dejan PÚBLICOS los estados `reservado` y `cerrado` (la ficha se conserva por
             SEO y por historial). Sin este aviso, un inmueble ya vendido seguiría mostrando precio y
             un botón de «Agendar visita»: quien escribe pierde el tiempo y nosotros la credibilidad. */
          <p class="ficha-estado" role="status">
            <strong>{aviso.titulo}.</strong> {aviso.detalle}
          </p>
        )}
        {precio ? (
          <>
            <p class="ficha-price__lbl">{precio.etiqueta}</p>
            <p class="ficha-price__val">{precio.valor}</p>
            {precio.sub && <p class="ficha-price__sub">{precio.sub}</p>}
          </>
        ) : (
          /* Sin precio publicado se DICE, no se deja el hueco: el visitante entiende que hay que
             preguntarlo en vez de pensar que la página está rota. */
          <>
            <p class="ficha-price__lbl">Precio</p>
            <p class="ficha-price__val ficha-price__val--consultar">A consultar</p>
          </>
        )}

        {aviso?.admiteVisita === false ? (
          <>
            <a class="alt-btn alt-btn--navy ficha-price__cta" href={rutaOperacion(p.operacion)}>
              Ver inmuebles parecidos<span class="alt-btn__arw"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </a>
            <a class="ficha-price__alt" href={`${SITE.contact.whatsappLink}?text=${waInfo}`} rel="noopener">Avísenme si se libera</a>
          </>
        ) : (
          <>
            <a class="alt-btn alt-btn--navy ficha-price__cta" href={`${SITE.contact.whatsappLink}?text=${waVisita}`} rel="noopener">
              Agendar visita<span class="alt-btn__arw"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </a>
            <a class="ficha-price__alt" href={`${SITE.contact.whatsappLink}?text=${waInfo}`} rel="noopener">Solicitar información</a>
          </>
        )}

        {/* EQUIPO, no una persona inventada (§60.3). El WhatsApp es el del negocio, que es real y
            está atendido; poner un nombre y una foto de archivo sería el mismo error que un listing
            fabricado, solo que con una cara. */}
        <div class="ficha-advisor">
          <span class="ficha-advisor__ini">AL</span>
          <div class="ficha-advisor__info">
            <span class="ficha-advisor__name">Equipo ALTORRA</span>
            <span class="ficha-advisor__role">Te atiende un asesor de la zona</span>
          </div>
          <a class="ficha-advisor__wa" href={`${SITE.contact.whatsappLink}?text=${waInfo}`} rel="noopener" aria-label="Contactar por WhatsApp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={ICO_WA}></svg></a>
        </div>
      </div>

      {/* CONFIANZA — datos verificables que el resto del mercado esconde. Cada línea sale de un campo
          real; si el campo falta, la línea no existe. */}
      {/* Sin condición: el código del inmueble SIEMPRE existe, así que el bloque siempre tiene al
          menos una línea verdadera que decir. La condición anterior miraba `codigoLegacy` mientras el
          cuerpo pinta `id`, así que podía esconder un dato que sí estaba. */}
      {(
        <div class="ficha-trust">
          <p class="alt-eyebrow">Sobre esta publicación</p>
          {p.verificadoAltorra && (
            <p class="ficha-trust__row ficha-trust__row--ok">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={ICO_CHECK}></svg>
              Verificado por ALTORRA
            </p>
          )}
          {frescura && <p class="ficha-trust__row">{frescura}</p>}
          <p class="ficha-trust__row ficha-trust__row--cod">Código {p.id}</p>
        </div>
      )}
    </aside>
  </div>

  <div class="ficha-secs">
    {amenidades.length > 0 && (
      <section class="ficha-sec">
        <h2>Amenidades</h2>
        <div class="ficha-amenities">
          {amenidades.map((a) => (
            <div class="ficha-amenity">
              <span class="alt-chip"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICO_CHECK}></svg></span>
              {a}
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="ficha-sec">
      <h2>Ficha técnica</h2>
      <div class="ficha-tec">
        {tecnica.map(([k, v]) => <div class="ficha-tec__row"><span>{k}</span><span>{v}</span></div>)}
      </div>
      {exhibeMatricula(p) && (
        /* Ley 820/2003 art. 31: la matrícula de arrendador va en la publicidad de arriendo de
           vivienda. Se repite AQUÍ además del footer a propósito: el benchmark de §92 encontró que
           ninguna inmobiliaria de la ciudad la exhibe, así que verla junto al inmueble es una señal de
           confianza. ⚠️ `exhibeMatricula` comprueba también la CIUDAD: la habilitación 6636 la expidió
           la Alcaldía de Cartagena y enseñarla sobre un inmueble de otra ciudad afirmaría una
           habilitación que allí no existe. */
        <p class="ficha-legal">Matrícula de Arrendador No. {SITE.matriculaArrendador}</p>
      )}
    </section>

    {historial.length > 0 && (
      <section class="ficha-sec">
        <h2>Historial de precio</h2>
        <div class="ficha-hist">
          {historial.map((h) => (
            <div class="ficha-hist__row">
              <span class="ficha-hist__f">{h.fecha}</span>
              <span class="ficha-hist__v">{h.valor}{sufijoPrecio(p.operacion)}</span>
              {h.direccion && (
                <span class={`ficha-hist__d ficha-hist__d--${h.direccion}`}>{h.direccion === 'baja' ? 'Bajó' : 'Subió'}</span>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    {(tieneMapa || zona) && (
      <section class="ficha-sec">
        <h2>Ubicación</h2>
        <div class={`ficha-loc${tieneMapa && zona ? '' : ' ficha-loc--sola'}`}>
          {tieneMapa && (
            <div class="ficha-locmap alt-map" role="region" aria-label={`Ubicación aproximada en ${ubicacion}`}
              data-alt-map
              data-markers={JSON.stringify(marcadores)}
              data-center={`${p.geo.lng},${p.geo.lat}`} data-zoom="15" data-pin-class="alt-mappin alt-mappin--ficha">
              <div class="alt-map__canvas" data-map-canvas></div>
              {/* Esquemático SELLADO = fallback hasta que el basemap pinte. */}
              <span class="ficha-locmap__grid" data-schematic></span>
              <span class="ficha-locmap__land" data-schematic></span>
              <span class="ficha-locmap__road" data-schematic></span>
              <span class="ficha-locmap__bay" data-schematic>Bahía de Cartagena</span>
              <span class="ficha-locmap__pin" data-schematic data-pin-idx="0">{p.geo?.barrio || 'Cartagena'}</span>
              <span class="ficha-locmap__note" data-schematic>ALTORRA · mapa esquemático</span>
            </div>
          )}
          {zona && (
            /* Lo que ocupaba la columna de «puntos de interés con minutos», que no están modelados.
               Esto sí es verdad y además enlaza a la landing del barrio (§92). */
            <div class="ficha-zona">
              <p class="alt-eyebrow">La zona</p>
              <h3 class="ficha-zona__h">{zona.nombre}</h3>
              <p class="ficha-zona__p">{zona.paraQuien}</p>
              <ul class="ficha-zona__ul">
                {zona.rasgos.slice(0, 3).map((r) => <li>{r}</li>)}
              </ul>
              <a class="alt-link-ul ficha-zona__link" href={`/zona/${zona.slug}`}>
                Cómo se vive en {zona.nombre}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          )}
        </div>
        <p class="ficha-legal">La ubicación del mapa es aproximada: señala el sector, no la dirección del inmueble.</p>
      </section>
    )}
  </div>

  {similares.length > 0 && (
    <section class="ficha-closer">
      <div class="ficha-closer__in">
        <h2>Propiedades similares</h2>
        <div class="ficha-similar">
          {/* SIN `badge` a propósito, como en el mockup: todas las similares comparten la operación de
              la propiedad que estás viendo, así que tres etiquetas «En venta» seguidas no informan de
              nada. En el SERP sí van, porque allí el listado puede mezclar operaciones. */}
          {similares.map((s) => (
            <PropertyCard
              img={urlMedia(s.thumb)}
              alt={s.titulo}
              inmId={s.id}
              zona={s.sector}
              beds={s.hab}
              baths={s.ban}
              area={s.area != null ? `${s.area} m²` : undefined}
              title={s.titulo}
              price={`$${new Intl.NumberFormat('es-CO').format(s.precio)}`}
              priceSuffix={sufijoPrecio(s.operacion).trim()}
              href={rutaFicha(s)}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</main>

<script type="application/ld+json" set:html={JSON.stringify(jsonLdProp)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(jsonLdBc)} is:inline />

<script>
  // Galería: clic en miniatura cambia la imagen principal.
  const main = document.getElementById('ficha-main') as HTMLImageElement | null;
  document.querySelectorAll('.ficha-thumb[data-src]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = (btn as HTMLElement).dataset.src;
      if (main && src) main.src = src;
      document.querySelectorAll('.ficha-thumb').forEach((b) => b.classList.remove('is-on'));
      btn.classList.add('is-on');
    });
  });

  // Favorito del encabezado: alterna estado on/off (navy + oro), como el toggleFav del mockup.
  const fav = document.querySelector('.ficha-fav');
  fav?.addEventListener('click', () => {
    const on = fav.getAttribute('aria-pressed') === 'true';
    fav.setAttribute('aria-pressed', on ? 'false' : 'true');
  });

  // Compartir: el mockup dibuja el botón y el demo no lo cableaba, así que no hacía NADA. Ahora usa
  // la API nativa donde existe (móvil) y copia el enlace donde no. Un botón que no responde se lee
  // como una página rota.
  const share = document.querySelector('.ficha-share');
  share?.addEventListener('click', async () => {
    const url = window.location.href;
    const title = document.title;
    try {
      if (navigator.share) await navigator.share({ title, url });
      else {
        await navigator.clipboard.writeText(url);
        share.setAttribute('aria-label', 'Enlace copiado');
      }
    } catch {
      /* El usuario canceló el diálogo de compartir: no es un error que haya que reportar. */
    }
  });

  // Mapa real (MapLibre + Protomaps, TODO-30): monta sobre el esquemático y lo reemplaza al pintar.
  // CONDICIONAL: una ficha sin coordenadas no pinta mapa, y el import arrastra maplibre-gl + pmtiles +
  // los basemaps de Protomaps. Bajarlos para no usarlos es peso puro, y se nota en una conexión móvil
  // de Cartagena mucho más que en este portátil.
  if (document.querySelector('[data-alt-map]')) {
    import('../scripts/altorra-map').then((m) => m.bootMaps());
  }
</script>

